---
import Header from '../components/Header.astro';
import FontFaces from '../components/FontFaces.astro';
import { url, pageUrl, preview, siteContent, ui, type Lang } from '../lib/site';
import '../styles/global.css';
import '../styles/figma-desktop.css';
import '../styles/meeting-revision.css';
import '../styles/experience.css';
import '../styles/section-heading.css';
interface Props {
  lang: Lang;
  page?: string;
  title: string;
  description?: string;
  bodyClass?: string;
}
const {
  lang,
  page = 'index',
  title,
  description = siteContent.metaDescription[lang],
  bodyClass = '',
} = Astro.props;
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(pageUrl(lang, page));
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fdfbf5" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      hreflang="zh-CN"
      href={absolute(pageUrl('zh', page))}
    />
    <link rel="alternate" hreflang="en" href={absolute(pageUrl('en', page))} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={absolute(pageUrl('zh', page))}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(siteContent.ogImageUrl)} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <FontFaces lang={lang} />
  </head>
  <body
    class={bodyClass}
    data-lang={lang}
    data-stories-status={ui.clientMessages.storiesShown[lang]}
    data-copied-status={ui.clientMessages.copied[lang]}
    data-copy-failed-status={ui.clientMessages.copyFailed[lang]}
  >
    <Header lang={lang} current={page} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <p class="sr-only" role="status" aria-live="polite" data-status></p>
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/topology-loader.ts"></script>
    <script src="../scripts/experience.ts"></script>
  </body>
</html>

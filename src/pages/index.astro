---
import { pageUrl, siteContent } from '../lib/site';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>{siteContent.redirectPage.title}</title>
    <meta http-equiv="refresh" content={`0;url=${pageUrl('zh')}`} />
  </head>
  <body>
    <a href={pageUrl('zh')}>{siteContent.redirectPage.zhLink}</a>
    <a href={pageUrl('en')}>{siteContent.redirectPage.enLink}</a>
  </body>
</html>

---
import { url } from '../lib/site';
import { CONTENT_DATA_FILE } from '../lib/content-editor-route';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>内容配置编辑器 · Link-X Capital</title>
  </head>
  <body data-editor-state="blocked" data-config-url={url(CONTENT_DATA_FILE)}>
    <main>
      <section class="gate-card" data-gate-card>
        <p class="eyebrow">CONTENT CONFIGURATION</p>
        <h1 data-gate-title>不可访问</h1>
        <p data-gate-message>
          此页面需要使用完整的调试入口。配置数据和编辑器模块均未加载。
        </p>
      </section>

      <section class="editor" data-editor hidden>
        <header class="editor-header">
          <div>
            <p class="eyebrow">LINK-X CAPITAL · LOCAL DRAFT</p>
            <h1>双语内容配置</h1>
            <p class="editor-note">
              （自动保存本地草稿；发布需导出 JSON 并重新构建。图片／视频放
              <code>public/assets</code>；洞察文章放
              <code>src/content/insights</code>。）
            </p>
          </div>
          <div class="toolbar">
            <button type="button" class="secondary" data-import>
              导入 JSON
            </button>
            <button type="button" data-export>
              导出 JSON
            </button>
            <input
              type="file"
              accept="application/json,.json"
              data-file-input
              hidden
            />
          </div>
        </header>

        <aside class="security-note">
          <strong>安全说明</strong>
          <span>
            固定哈希地址和 <code>debug=true</code>{' '}
            只是隐藏入口，不是身份认证。不要在配置中填写密码、令牌或其他敏感数据。
          </span>
        </aside>

        <div class="status-row">
          <p role="status" aria-live="polite" data-save-status>
            正在载入配置…
          </p>
          <p data-validation-summary></p>
        </div>
        <section class="error-panel" data-errors hidden>
          <h2>配置问题</h2>
          <ul data-error-list></ul>
        </section>
        <div class="editor-layout">
          <nav
            class="group-nav"
            aria-label="配置分组"
            role="tablist"
            data-group-nav
          ></nav>
          <form data-config-form novalidate></form>
        </div>
      </section>

      <dialog
        class="confirm-dialog"
        data-confirm-dialog
        aria-labelledby="confirm-dialog-title"
        aria-describedby="confirm-dialog-message"
      >
        <form method="dialog">
          <div class="confirm-icon" aria-hidden="true">
            <span></span>
          </div>
          <p class="confirm-kicker">REMOVE FROM DRAFT</p>
          <h2 id="confirm-dialog-title" data-confirm-title>
            确认删除？
          </h2>
          <p id="confirm-dialog-message" data-confirm-message></p>
          <div class="confirm-actions">
            <button
              type="submit"
              value="cancel"
              class="confirm-cancel"
              data-confirm-cancel
            >
              取消
            </button>
            <button
              type="submit"
              value="confirm"
              class="confirm-accept"
              data-confirm-accept
            >
              确认删除
            </button>
          </div>
        </form>
      </dialog>
    </main>

    <script>
      const body = document.body;
      const values = new URLSearchParams(location.search).getAll('debug');
      const allowed = values.length === 1 && values[0] === 'true';
      if (allowed) {
        body.dataset.editorState = 'loading';
        const title = document.querySelector('[data-gate-title]');
        const message = document.querySelector('[data-gate-message]');
        if (title) title.textContent = '正在载入';
        if (message) message.textContent = '正在读取项目默认配置…';
        import('../scripts/content-editor.ts')
          .then(({ initContentEditor }) => initContentEditor())
          .catch((error) => {
            body.dataset.editorState = 'error';
            if (title) title.textContent = '编辑器载入失败';
            if (message)
              message.textContent =
                error instanceof Error ? error.message : '未知载入错误';
          });
      }
    </script>
  </body>
</html>

<style>
  :root {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    color: #171719;
    background: #f2f3f5;
    font-synthesis: none;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    min-width: 320px;
  }
  button,
  input,
  textarea,
  select {
    font: inherit;
  }
  button {
    border: 0;
    border-radius: 8px;
    padding: 11px 17px;
    color: white;
    background: #5b35d5;
    cursor: pointer;
  }
  button:hover {
    background: #4c28c2;
  }
  button.secondary {
    color: #25252a;
    background: #e7e7ec;
  }
  button.secondary:hover {
    background: #dadae2;
  }
  code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  main {
    width: min(1500px, 100%);
    margin: 0 auto;
    padding: 28px;
  }
  .gate-card {
    max-width: 620px;
    margin: 16vh auto 0;
    padding: 36px;
    border: 1px solid #dadbe0;
    border-radius: 16px;
    background: white;
    box-shadow: 0 16px 50px rgb(27 27 35 / 8%);
  }
  [data-editor-state='ready'] .gate-card {
    display: none;
  }
  .eyebrow {
    margin: 0 0 12px;
    color: #6b6b75;
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(28px, 4vw, 46px);
  }
  h2,
  h3,
  p {
    margin-top: 0;
  }
  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding: 26px 28px;
    border: 1px solid #dedee4;
    border-radius: 16px;
    background: white;
  }
  .editor-note {
    max-width: 800px;
    margin-bottom: 0;
    color: #86868b;
    font-size: 12px;
    line-height: 1.5;
  }
  .toolbar {
    display: flex;
    flex: 0 0 auto;
    gap: 10px;
  }
  .security-note {
    display: flex;
    gap: 16px;
    margin: 14px 0;
    padding: 14px 18px;
    border: 1px solid #e4c681;
    border-radius: 10px;
    color: #5f4610;
    background: #fff7df;
    line-height: 1.5;
  }
  .security-note strong {
    flex: 0 0 auto;
  }
  .status-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin: 14px 0;
    padding: 0 4px;
    color: #62626b;
    font-size: 14px;
  }
  .status-row p {
    margin: 0;
  }
  [data-save-status][data-state='saved'] {
    color: #187448;
  }
  [data-save-status][data-state='error'] {
    color: #b2202d;
  }
  .error-panel {
    margin: 14px 0;
    padding: 18px 22px;
    border: 1px solid #e8a0a5;
    border-radius: 10px;
    color: #801925;
    background: #fff1f2;
  }
  .error-panel h2 {
    font-size: 16px;
  }
  .error-panel ul {
    display: grid;
    gap: 8px;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
    line-height: 1.55;
  }
  :global(.validation-error-item) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    border: 1px solid rgb(178 32 45 / 12%);
    border-radius: 12px;
    padding: 11px 12px 11px 14px;
    background: rgb(255 255 255 / 64%);
  }
  :global(.validation-error-copy) {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  :global(.validation-error-location) {
    color: #721824;
    font-size: 13px;
    font-weight: 700;
  }
  :global(.validation-error-detail) {
    color: #9b3c48;
    font-size: 12px;
  }
  :global(.validation-error-locate) {
    border: 1px solid #efc8cd;
    border-radius: 999px;
    padding: 7px 13px;
    color: #a51e30;
    background: #ffffff;
    box-shadow: 0 1px 2px rgb(97 17 27 / 6%);
    font-size: 12px;
    font-weight: 650;
  }
  :global(.validation-error-locate:hover) {
    border-color: #dfabb2;
    color: #8f1425;
    background: #fff5f6;
  }
  :global(.field.is-error-target input),
  :global(.field.is-error-target textarea),
  :global(.field.is-error-target select) {
    border-color: #cf3548;
    box-shadow: 0 0 0 3px rgb(207 53 72 / 12%);
  }
  .confirm-dialog {
    width: min(440px, calc(100vw - 32px));
    border: 1px solid rgb(255 255 255 / 72%);
    border-radius: 24px;
    padding: 0;
    color: #17171d;
    background: rgb(250 250 253 / 96%);
    box-shadow:
      0 32px 90px rgb(17 13 35 / 24%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
  }
  .confirm-dialog::backdrop {
    background: rgb(19 17 28 / 38%);
    backdrop-filter: blur(12px) saturate(0.85);
  }
  .confirm-dialog form {
    padding: 30px;
    text-align: center;
  }
  .confirm-icon {
    display: grid;
    width: 52px;
    height: 52px;
    margin: 0 auto 18px;
    place-items: center;
    border: 1px solid rgb(196 54 70 / 20%);
    border-radius: 50%;
    background: linear-gradient(145deg, #fff4f5, #ffe1e5);
    box-shadow: 0 10px 28px rgb(178 34 51 / 12%);
  }
  .confirm-icon span {
    position: relative;
    width: 16px;
    height: 18px;
    border: 2px solid #b22637;
    border-top: 0;
    border-radius: 2px 2px 5px 5px;
  }
  .confirm-icon span::before {
    position: absolute;
    top: -5px;
    left: -4px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: #b22637;
    content: '';
  }
  .confirm-kicker {
    margin-bottom: 9px;
    color: #8c8897;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
  }
  .confirm-dialog h2 {
    margin-bottom: 10px;
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .confirm-dialog [data-confirm-message] {
    margin: 0 auto;
    color: #66636f;
    font-size: 14px;
    line-height: 1.65;
  }
  .confirm-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 26px;
  }
  .confirm-actions button {
    border-radius: 999px;
    padding: 12px 18px;
    font-weight: 650;
  }
  .confirm-actions .confirm-cancel {
    color: #34323b;
    background: #eaeaef;
  }
  .confirm-actions .confirm-cancel:hover {
    background: #dddde5;
  }
  .confirm-actions .confirm-accept {
    background: #aa2232;
    box-shadow: 0 8px 22px rgb(170 34 50 / 18%);
  }
  .confirm-actions .confirm-accept:hover {
    background: #951b2a;
  }
  .editor-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }
  .group-nav {
    position: sticky;
    top: 18px;
    display: grid;
    gap: 4px;
    padding: 10px;
    border: 1px solid #dedee4;
    border-radius: 12px;
    background: white;
  }
  .group-nav :global(.group-tab) {
    width: 100%;
    border: 0;
    padding: 10px 12px;
    border-radius: 7px;
    color: #3d3d45;
    background: transparent;
    text-align: left;
    text-decoration: none;
  }
  .group-nav :global(.group-tab:hover) {
    color: #4c28c2;
    background: #f2efff;
  }
  .group-nav :global(.group-tab[aria-selected='true']) {
    color: white;
    background: #5b35d5;
  }
  [data-config-form] {
    display: grid;
    gap: 18px;
    min-width: 0;
  }
  :global(.config-section) {
    scroll-margin-top: 18px;
    padding: 24px;
    border: 1px solid #dedee4;
    border-radius: 12px;
    background: white;
  }
  :global(.config-section > h2) {
    margin-bottom: 20px;
    font-size: 23px;
  }
  :global(.object-group) {
    display: grid;
    gap: 14px;
    margin: 12px 0 0;
    padding: 16px;
    border: 1px solid #e5e5ea;
    border-radius: 9px;
  }
  :global(.object-group > legend) {
    padding: 0 7px;
    color: #555560;
    font-weight: 650;
  }
  :global(.title-note) {
    margin-left: 5px;
    color: #85858f;
    font-size: 11px;
    font-weight: 450;
    line-height: 1.5;
  }
  :global(.record-list) {
    display: grid;
    gap: 14px;
  }
  :global(.record-card) {
    padding: 16px;
    border: 1px solid #dfdfe6;
    border-radius: 9px;
    background: #fafafd;
  }
  :global(.record-card > h3) {
    margin-bottom: 14px;
    font-size: 16px;
  }
  :global(.collection-group) {
    padding: 18px;
  }
  :global(.collection-layout) {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }
  :global(.collection-sidebar) {
    position: sticky;
    top: 18px;
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  :global(.collection-header) {
    display: grid;
    gap: 8px;
  }
  :global(.collection-hint) {
    margin: 0;
    color: #74747e;
    font-size: 12px;
    line-height: 1.45;
  }
  :global(.collection-add) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    overflow: hidden;
    border: 1px solid #4930bb;
    border-radius: 999px;
    padding: 11px 16px;
    color: #f8f7ff;
    background: #5638d4;
    box-shadow: 0 7px 18px rgb(69 45 177 / 20%);
    font-weight: 650;
    letter-spacing: 0.01em;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      background-color 180ms ease;
  }
  :global(.collection-add:hover) {
    border-color: #3f28ab;
    color: #ffffff;
    background: #482dbd;
    box-shadow: 0 9px 22px rgb(69 45 177 / 26%);
    transform: translateY(-1px);
  }
  :global(.collection-add:active) {
    transform: scale(0.985);
  }
  :global(.collection-add-icon) {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 44%);
    border-radius: 50%;
    color: #ffffff;
    background: transparent;
    font-size: 18px;
    font-weight: 400;
    line-height: 1;
  }
  :global(.record-tabs) {
    display: grid;
    gap: 7px;
    max-height: 62vh;
    overflow: auto;
    padding: 2px;
  }
  :global(.record-tab-row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 5px;
    padding: 4px;
    border: 1px solid #dedee5;
    border-radius: 8px;
    background: white;
  }
  :global(.record-tab-row.is-dragging) {
    opacity: 0.45;
  }
  :global(.record-tab-row.is-drag-target) {
    border-color: #6b48dd;
    box-shadow: 0 0 0 2px rgb(107 72 221 / 14%);
  }
  :global(.record-tab) {
    display: flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    padding: 8px;
    color: #373741;
    background: transparent;
    text-align: left;
  }
  :global(.record-tab:hover) {
    color: #4c28c2;
    background: #f4f1ff;
  }
  :global(.record-tab[aria-selected='true']) {
    color: white;
    background: #5b35d5;
  }
  :global(.drag-mark) {
    flex: 0 0 auto;
    color: currentColor;
    cursor: grab;
    opacity: 0.55;
  }
  :global(.record-tab-label) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  :global(.record-tab-actions) {
    display: grid;
    grid-template-columns: repeat(2, 32px);
    gap: 5px;
  }
  :global(.record-move) {
    width: 32px;
    height: 32px;
    border: 1px solid #dedee4;
    border-radius: 9px;
    padding: 0;
    color: #3f3f46;
    background: #f5f5f7;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 6%),
      inset 0 1px 0 rgb(255 255 255 / 85%);
    font-size: 15px;
    font-weight: 600;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 120ms ease;
  }
  :global(.record-move:hover) {
    border-color: #cbcbd2;
    color: #5036c7;
    background: #eaeaef;
  }
  :global(.record-move:active) {
    background: #dfdfe5;
    transform: scale(0.94);
  }
  :global(.record-move:disabled) {
    border-color: #e8e8ec;
    color: #b8b8bf;
    background: #f8f8fa;
    box-shadow: none;
    cursor: not-allowed;
    opacity: 1;
    transform: none;
  }
  :global(.record-panel) {
    min-width: 0;
    padding: 18px;
    border: 1px solid #dfdfe6;
    border-radius: 9px;
    background: #fafafd;
  }
  :global(.record-panel-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  :global(.record-panel-header h3) {
    margin: 0;
    font-size: 18px;
  }
  :global(.record-delete) {
    border: 1px solid #e2e2e7;
    border-radius: 999px;
    padding: 8px 15px;
    color: #c12639;
    background: #f5f5f7;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 5%),
      inset 0 1px 0 rgb(255 255 255 / 88%);
    font-size: 13px;
    font-weight: 650;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 120ms ease;
  }
  :global(.record-delete:hover) {
    border-color: #f0c9ce;
    color: #a8192b;
    background: #fff0f2;
  }
  :global(.record-delete:active) {
    background: #f9dfe3;
    transform: scale(0.96);
  }
  :global(.field),
  :global(.language-field) {
    display: grid;
    gap: 7px;
    min-width: 0;
  }
  :global(.field-label) {
    color: #3e3e47;
    font-size: 13px;
    font-weight: 650;
  }
  :global(.field-note) {
    color: #767680;
    font-size: 12px;
    line-height: 1.4;
  }
  :global(.language-pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  :global(.language-badge) {
    display: inline-flex;
    width: fit-content;
    margin-left: 6px;
    padding: 2px 6px;
    border-radius: 4px;
    color: #5b35d5;
    background: #eee9ff;
    font-size: 11px;
  }
  :global(input[type='text']),
  :global(input[type='url']),
  :global(input[type='number']),
  :global(input[type='email']),
  :global(textarea),
  :global(select) {
    width: 100%;
    border: 1px solid #cfcfd7;
    border-radius: 7px;
    padding: 10px 11px;
    color: #1d1d22;
    background: white;
    line-height: 1.5;
  }
  :global(textarea) {
    min-height: 112px;
    resize: vertical;
  }
  :global(input:focus),
  :global(textarea:focus),
  :global(select:focus) {
    outline: 2px solid #6b48dd;
    outline-offset: 1px;
  }
  :global(input[readonly]),
  :global(textarea[readonly]) {
    color: #6f6f77;
    background: #ededf1;
    cursor: not-allowed;
  }
  :global(.boolean-field) {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  :global(.primitive-list) {
    display: grid;
    gap: 9px;
  }
  @media (max-width: 820px) {
    main {
      padding: 14px;
    }
    .editor-header {
      align-items: stretch;
      flex-direction: column;
      padding: 20px;
    }
    .toolbar {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .editor-layout {
      grid-template-columns: 1fr;
    }
    .group-nav {
      position: static;
      grid-template-columns: repeat(2, 1fr);
    }
    :global(.language-pair) {
      grid-template-columns: 1fr;
    }
    :global(.collection-layout) {
      grid-template-columns: 1fr;
    }
    :global(.collection-sidebar) {
      position: static;
    }
    :global(.record-tabs) {
      max-height: 300px;
    }
    :global(.validation-error-item) {
      align-items: start;
      gap: 10px;
    }
    :global(.config-section) {
      padding: 17px;
    }
    .security-note,
    .status-row {
      flex-direction: column;
      gap: 7px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.collection-add) {
      transition: none;
    }
  }
</style>

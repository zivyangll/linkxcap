---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pageUrl } from '../lib/site';
---

<SiteLayout lang="zh" title="页面未找到" page="index">
  <section class="not-found">
    <p>LOST SIGNAL</p>
    <h1>404</h1>
    <p>
      这个信号暂时没有抵达。
      <br />
      This page could not be found.
    </p>
    <a href={pageUrl('zh')}>返回首页 · Back home</a>
    <a href={pageUrl('en')}>English</a>
  </section>
</SiteLayout>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pageUrl, siteContent } from '../lib/site';
---

<SiteLayout lang="zh" title={siteContent.notFound.title.zh} page="index">
  <section class="not-found">
    <p>404</p>
    <h1>{siteContent.notFound.title.zh}</h1>
    <p lang="en">{siteContent.notFound.title.en}</p>
    <p>
      {siteContent.notFound.body.zh}
      <br />
      {siteContent.notFound.body.en}
    </p>
    <a href={pageUrl('zh')}>{siteContent.notFound.back.zh}</a>
    <a href={pageUrl('en')} lang="en">
      {siteContent.notFound.back.en}
    </a>
  </section>
</SiteLayout>

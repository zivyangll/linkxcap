---
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Portfolio from '../../components/Portfolio.astro';
import CompanyDetail from '../../components/CompanyDetail.astro';
import Team from '../../components/Team.astro';
import Profile from '../../components/Profile.astro';
import Insights from '../../components/Insights.astro';
import Fellowship from '../../components/Fellowship.astro';
import Article from '../../components/Article.astro';
import Legal from '../../components/Legal.astro';
import {
  languages,
  pageUrl,
  organizationId,
  companies,
  team,
  insightFilters,
  insightArticleFromData,
  pageDescription,
  pageTitle,
  siteContent,
  ui,
  type Lang,
  type Company,
  type InsightArticle,
} from '../../lib/site';

export async function getStaticPaths() {
  const bodies = await getCollection('insights');
  const articles = bodies.map((body) => ({
    ...insightArticleFromData(body.data),
    body,
  }));
  const routeKeys = articles.map(({ lang, route }) => `${lang}:${route}`);
  if (new Set(routeKeys).size !== routeKeys.length)
    throw new Error(
      'Insight Markdown files contain duplicate language routes.',
    );
  const articleKeys = articles.map(({ id, lang }) => `${id}:${lang}`);
  if (new Set(articleKeys).size !== articleKeys.length)
    throw new Error(
      'Insight Markdown files contain duplicate language entries.',
    );
  // `all` is the aggregate UI control. Articles must point to one concrete
  // filter id so that selecting a category always has deterministic results.
  const filterIds = new Set(
    insightFilters.filter(({ id }) => id !== 'all').map(({ id }) => id),
  );
  const unknownCategories = articles.filter(
    ({ category }) => !filterIds.has(category),
  );
  if (unknownCategories.length)
    throw new Error(
      `Insight Markdown category must match a concrete content filter id ("all" is reserved): ${unknownCategories.map(({ id, lang, category }) => `${id}.${lang} -> ${category}`).join(', ')}`,
    );
  const languagePairs = new Map<string, Set<Lang>>();
  for (const { id, lang } of articles) {
    const pair = languagePairs.get(id) || new Set<Lang>();
    pair.add(lang);
    languagePairs.set(id, pair);
  }
  const incomplete = [...languagePairs].filter(([, pair]) => pair.size !== 2);
  if (incomplete.length)
    throw new Error(
      `Insight Markdown files require zh/en pairs: ${incomplete.map(([id]) => id).join(', ')}`,
    );
  const inconsistentPairs = [...languagePairs.keys()].flatMap((id) => {
    const pair = articles.filter((article) => article.id === id);
    const fields = ['route', 'category'] as const;
    return fields
      .filter(
        (field) => new Set(pair.map((article) => article[field])).size > 1,
      )
      .map((field) => `${id}.${field}`);
  });
  if (inconsistentPairs.length)
    throw new Error(
      `Insight zh/en pairs must use the same route and category: ${inconsistentPairs.join(', ')}`,
    );
  return languages.flatMap((lang) => [
    ...['portfolio', 'team', 'insights', 'fellowship', 'legal'].map((page) => ({
      params: { lang, page },
      props: { kind: page },
    })),
    ...companies.map((company) => ({
      params: { lang, page: `portfolio/${company.slug}` },
      props: { kind: 'company', company },
    })),
    ...team.map((person) => ({
      params: { lang, page: `team-${person.slug}` },
      props: { kind: 'person', person },
    })),
    ...articles
      .filter((a) => a.lang === lang)
      .map((article) => ({
        params: { lang, page: article.route },
        props: { kind: 'article', article },
      })),
  ]);
}
const lang = Astro.params.lang as Lang;
const page = Astro.params.page!;
interface Props {
  kind: string;
  company?: Company;
  person?: (typeof team)[number];
  article?: InsightArticle & { body: CollectionEntry<'insights'> };
}
const { kind, company, person, article } = Astro.props;
const contentTitle = company
  ? lang === 'zh'
    ? company.name
    : company.nameEn
  : person
    ? lang === 'zh'
      ? person.name
      : person.en
    : article
      ? article.title
      : pageTitle(lang, kind as Parameters<typeof pageTitle>[1]);
const title =
  company || person || article
    ? lang === 'zh'
      ? `${contentTitle}｜${siteContent.brandZh}`
      : `${contentTitle} — ${siteContent.brand}`
    : contentTitle;
// A person's page is described by the first paragraph of their own bio.
const personDescription = (person: (typeof team)[number]) =>
  person.bio[lang].split(/\n\s*\n/)[0].trim() || person.summary[lang];
const description = article
  ? article.summary
  : company
    ? lang === 'zh'
      ? company.detail
      : company.detailEn
    : person
      ? personDescription(person)
      : pageDescription(lang, kind as Parameters<typeof pageDescription>[1]);
// Structured data for what this page describes; the layout adds the shared
// organisation, website and web page nodes.
const absolute = (target: string) =>
  new URL(pageUrl(lang, target), Astro.site).href;
const pageId = `${absolute(page)}#webpage`;
const organization = { '@id': organizationId(Astro.site) };
const name = (zh: string, en: string) => (lang === 'zh' ? zh : en);
const itemList = (items: { name: string; page: string }[]) => ({
  '@type': 'ItemList',
  numberOfItems: items.length,
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: absolute(item.page),
  })),
});
const listArticles =
  kind === 'insights'
    ? (await getCollection('insights'))
        .map(({ data }) => data)
        .filter((data) => data.lang === lang)
        .sort((x, y) => y.date.localeCompare(x.date))
    : [];
const mainEntity =
  kind === 'portfolio'
    ? itemList(
        companies.map((c) => ({
          name: name(c.name, c.nameEn),
          page: `portfolio/${c.slug}`,
        })),
      )
    : kind === 'team'
      ? itemList(
          team.map((p) => ({
            name: name(p.name, p.en),
            page: `team-${p.slug}`,
          })),
        )
      : kind === 'insights'
        ? itemList(listArticles.map((a) => ({ name: a.title, page: a.route })))
        : undefined;
// Trail below the home page, as in the site navigation.
const breadcrumbs = company
  ? [
      { name: '', page: 'portfolio' },
      { name: contentTitle, page },
    ]
  : person
    ? [
        { name: '', page: 'team' },
        { name: contentTitle, page },
      ]
    : article
      ? [
          { name: '', page: 'insights' },
          { name: contentTitle, page },
        ]
      : [{ name: kind === 'legal' ? ui[lang].legal : '', page: kind }];
const category = article
  ? insightFilters.find(({ id }) => id === article.category)
  : undefined;
const schema = article
  ? [
      {
        '@type': 'Article',
        '@id': `${absolute(page)}#article`,
        headline: article.title,
        description: article.summary,
        datePublished: article.date,
        inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
        ...(category ? { articleSection: category[lang] } : {}),
        author: organization,
        publisher: organization,
        image: new URL(siteContent.ogImageUrl, Astro.site).href,
        mainEntityOfPage: { '@id': pageId },
      },
    ]
  : person
    ? [
        {
          '@type': 'Person',
          '@id': `${absolute(page)}#person`,
          name: name(person.name, person.en),
          alternateName: name(person.en, person.name),
          jobTitle: person.role[lang],
          description,
          worksFor: organization,
          image: new URL(person.imageUrl, Astro.site).href,
          mainEntityOfPage: { '@id': pageId },
        },
      ]
    : company
      ? [
          {
            // A portfolio company, described on this page; no ownership or
            // parent relation is claimed.
            '@type': 'Organization',
            '@id': `${absolute(page)}#company`,
            name: name(company.name, company.nameEn),
            alternateName: name(company.nameEn, company.name),
            description,
            ...(company.website ? { url: company.website } : {}),
            logo: new URL(company.logoUrl, Astro.site).href,
            subjectOf: { '@id': pageId },
          },
        ]
      : [];
const pageType = ['portfolio', 'team', 'insights'].includes(kind)
  ? 'CollectionPage'
  : person
    ? 'ProfilePage'
    : 'WebPage';
---

<SiteLayout
  lang={lang}
  page={page}
  title={title}
  description={description}
  schema={schema}
  pageType={pageType}
  mainEntity={
    mainEntity ||
    (person
      ? { '@id': `${absolute(page)}#person` }
      : company
        ? { '@id': `${absolute(page)}#company` }
        : article
          ? { '@id': `${absolute(page)}#article` }
          : undefined)
  }
  breadcrumbs={breadcrumbs}
  ogType={article ? 'article' : 'website'}
  bodyClass={[
    ['team', 'person', 'insights', 'article', 'fellowship'].includes(kind)
      ? 'alt-paper'
      : '',
    kind === 'portfolio' ? 'portfolio-view' : '',
  ]
    .filter(Boolean)
    .join(' ')}
>
  {kind === 'portfolio' && <Portfolio lang={lang} />}
  {company && <CompanyDetail lang={lang} company={company} />}
  {kind === 'team' && <Team lang={lang} />}
  {person && <Profile lang={lang} person={person} />}
  {kind === 'insights' && <Insights lang={lang} />}
  {kind === 'fellowship' && <Fellowship lang={lang} />}
  {article && <Article lang={lang} article={article} />}
  {kind === 'legal' && <Legal lang={lang} />}
</SiteLayout>

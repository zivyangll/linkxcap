---
import { getCollection, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Portfolio from '../../components/Portfolio.astro';
import CompanyDetail from '../../components/CompanyDetail.astro';
import Team from '../../components/Team.astro';
import Profile from '../../components/Profile.astro';
import Insights from '../../components/Insights.astro';
import Article from '../../components/Article.astro';
import Contact from '../../components/Contact.astro';
import Legal from '../../components/Legal.astro';
import {
  languages,
  companies,
  team,
  insightArticles,
  insightFileId,
  pageTitle,
  type Lang,
  type Company,
  type InsightArticle,
} from '../../lib/site';

export async function getStaticPaths() {
  const bodies = await getCollection('insights');
  const bodyById = new Map(bodies.map((body) => [body.id, body]));
  const articles = insightArticles.map((meta) => {
    const body = bodyById.get(insightFileId(meta.file));
    if (!body)
      throw new Error(
        `Missing insight Markdown file: src/content/insights/${meta.file}`,
      );
    return { ...meta, body };
  });
  const registered = new Set(
    insightArticles.map((item) => insightFileId(item.file)),
  );
  const unregistered = bodies.filter((body) => !registered.has(body.id));
  if (unregistered.length)
    throw new Error(
      `Insight Markdown files missing from data/content.json: ${unregistered.map((body) => body.id).join(', ')}`,
    );
  return languages.flatMap((lang) => [
    ...['portfolio', 'team', 'insights', 'contact', 'legal'].map((page) => ({
      params: { lang, page },
      props: { kind: page },
    })),
    ...companies.map((company) => ({
      params: { lang, page: `portfolio/${company.slug}` },
      props: { kind: 'company', company },
    })),
    ...team.map((person) => ({
      params: { lang, page: `team-${person.id}` },
      props: { kind: 'person', person },
    })),
    ...articles
      .filter((a) => a.lang === lang)
      .map((article) => ({
        params: { lang, page: article.route },
        props: { kind: 'article', article },
      })),
  ]);
}
const lang = Astro.params.lang as Lang;
const page = Astro.params.page!;
interface Props {
  kind: string;
  company?: Company;
  person?: (typeof team)[number];
  article?: InsightArticle & { body: CollectionEntry<'insights'> };
}
const { kind, company, person, article } = Astro.props;
const title = company
  ? lang === 'zh'
    ? company.name
    : company.nameEn
  : person
    ? lang === 'zh'
      ? person.name
      : person.en
    : article
      ? article.title
      : pageTitle(lang, kind as Parameters<typeof pageTitle>[1]);
---

<SiteLayout
  lang={lang}
  page={page}
  title={title}
  description={article?.summary}
  minimal={kind === 'company'}
  footer={!['portfolio', 'company', 'team', 'insights'].includes(kind)}
  bodyClass={
    ['team', 'person', 'insights', 'article', 'contact'].includes(kind)
      ? 'alt-paper'
      : ''
  }
>
  {kind === 'portfolio' && <Portfolio lang={lang} />}
  {company && <CompanyDetail lang={lang} company={company} />}
  {kind === 'team' && <Team lang={lang} />}
  {person && <Profile lang={lang} person={person} />}
  {kind === 'insights' && <Insights lang={lang} />}
  {article && <Article lang={lang} article={article} />}
  {kind === 'contact' && <Contact lang={lang} />}
  {kind === 'legal' && <Legal lang={lang} />}
</SiteLayout>

---
import {
  companies,
  sectors,
  portfolioContent,
  asset,
  pageUrl,
  ui,
  pick,
  type Company,
  type Lang,
} from '../lib/site';
import PageTitle from './PageTitle.astro';
import CompanyLogo from './CompanyLogo.astro';
import Arrow from './Arrow.astro';
const { lang, company } = Astro.props as { lang: Lang; company: Company };
const sector = sectors.find((s) => s.id === company.sector)!;
const records = companies.map((c) => ({
  id: c.id,
  slug: c.slug,
  title: pick(lang, c.name, c.nameEn),
  sector: pick(
    lang,
    sectors.find((s) => s.id === c.sector)!.zh,
    sectors.find((s) => s.id === c.sector)!.en,
  ),
  description: pick(lang, c.detail, c.detailEn),
  english: c.detailEn,
  website: c.website || '',
  logo: c.logoUrl,
  url: pageUrl(lang, `portfolio/${c.slug}`),
  zhUrl: pageUrl('zh', `portfolio/${c.slug}`),
  enUrl: pageUrl('en', `portfolio/${c.slug}`),
}));
---

<section
  class="company-detail company-browser"
  data-company-browser
  data-current-company={company.slug}
  data-node-id={company.id === 'mosi' ? '2002:1359' : '2002:1282'}
>
  <div class="company-heading">
    <PageTitle
      as="h2"
      zh={portfolioContent.title.zh}
      en={portfolioContent.title.en}
      lang={lang}
    />
    <a class="text-link" href={pageUrl(lang, 'portfolio')}>
      {ui[lang].all}
    </a>
  </div>
  <img
    class="company-orbit"
    src={asset('1282', 'imgEllipse9')}
    width="1187"
    height="1187"
    alt=""
  />
  <article class="company-content" aria-live="polite" aria-atomic="true">
    <CompanyLogo company={company} detail />
    <h1 data-company-title>{pick(lang, company.name, company.nameEn)}</h1>
    <p class="company-sector" data-company-sector>
      {pick(lang, sector.zh, sector.en)}
    </p>
    <div class="company-description">
      <p data-company-description>
        {pick(lang, company.detail, company.detailEn)}
      </p>
      {lang === 'zh' && (
        <p class="secondary-description" lang="en" data-company-english>
          {company.detailEn}
        </p>
      )}
    </div>
    <a
      class="website-link"
      href={company.website}
      hidden={!company.website}
      target="_blank"
      rel="noopener noreferrer"
      data-company-website
    >
      {ui[lang].website}
      <Arrow />
    </a>
  </article>
  <div class="company-rail-shell">
    <div
      class="company-arc-continuation"
      data-company-arc-continuation
      aria-hidden="true"
    >
      {Array.from({ length: 6 }, (_, index) => (
        <i data-arc-side="top" data-arc-step={index + 1}></i>
      ))}
      {Array.from({ length: 6 }, (_, index) => (
        <i data-arc-side="bottom" data-arc-step={index + 1}></i>
      ))}
    </div>
    <p class="company-scroll-hint">{portfolioContent.scrollHint[lang]}</p>
    <nav
      class="company-navigator"
      data-company-nav
      aria-label={portfolioContent.navigatorLabel[lang]}
      tabindex="0"
    >
      <div class="company-nav-track">
        {companies.map((c) => (
          <a
            href={pageUrl(lang, `portfolio/${c.slug}`)}
            data-company-link={c.slug}
            aria-current={c.slug === company.slug ? 'page' : undefined}
          >
            <span class="rail-marker" aria-hidden="true">
              <img src={asset('audit', '1329')} width="53" height="53" alt="" />
            </span>
            <span>
              <strong>{c.nameEn.toUpperCase()}</strong>
              {lang === 'zh' && <span> / {c.name}</span>}
            </span>
          </a>
        ))}
      </div>
    </nav>
    <div class="rail-controls">
      <button data-company-previous aria-label={ui[lang].previous}>
        ↑
      </button>
      <button data-company-next aria-label={ui[lang].next}>
        ↓
      </button>
    </div>
  </div>
  <script
    type="application/json"
    data-company-records
    set:html={JSON.stringify(records).replaceAll('<', '\\u003c')}
  ></script>
</section>
<script src="../scripts/company-browser.ts"></script>

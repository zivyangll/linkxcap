---
import {
  team,
  teamIntro,
  asset,
  pageUrl,
  pick,
  ui,
  type Lang,
} from '../lib/site';
import PageTitle from './PageTitle.astro';
const { lang } = Astro.props as { lang: Lang };
const members = team.slice(0, 3);
---

<section class="team-review" data-team-review data-node-id="2002:4567">
  <div class="team-review-heading">
    <PageTitle zh="团队" en="Our Team" lang={lang} />
    <p>{teamIntro}</p>
  </div>
  <div class="team-explorer">
    <div class="team-portraits">
      {members.map((person) => (
        <div class="team-member">
          <button
            class="profile-toggle member-portrait"
            data-person={person.id}
            aria-controls={`profile-${person.id}`}
            aria-expanded="false"
            aria-label={`${pick(lang, person.name, person.en)} · ${ui[lang].expand}`}
          >
            <img
              src={asset('4729', person.image)}
              width="440"
              height="640"
              alt={pick(lang, person.name, person.en)}
            />
            <span class="member-caption">
              <strong>{pick(lang, person.name, person.en)}</strong>
              <span>{person.role[lang]}</span>
            </span>
          </button>
          <noscript>
            <a href={pageUrl(lang, `team-${person.id}`)}>
              {ui[lang].profile} ↗
            </a>
          </noscript>
        </div>
      ))}
    </div>
    <div class="team-biographies" aria-live="polite">
      {members.map((person) => (
        <article
          class="member-bio team-bio"
          id={`profile-${person.id}`}
          data-person-bio={person.id}
          hidden
        >
          <p class="eyebrow">LINK-X CAPITAL / {person.role.en}</p>
          <h2>{pick(lang, person.name, person.en)}</h2>
          {lang === 'zh' && <p class="member-en">{person.en}</p>}
          <p class="member-role">{person.role[lang]}</p>
          <p class="member-copy">{person.bio[lang]}</p>
          <p class="data-note">{ui[lang].mock}</p>
          <a class="line-link" href={pageUrl(lang, `team-${person.id}`)}>
            {ui[lang].profile} ↗
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
<script src="../scripts/team.ts"></script>

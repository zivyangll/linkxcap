---
import { team, teamContent, pageUrl, pick, ui, type Lang } from '../lib/site';
import PageTitle from './PageTitle.astro';
import '../styles/team-review.css';
const { lang } = Astro.props as { lang: Lang };
const members = team;
---

<section class="team-review" data-team-review data-node-id="2002:4567">
  <div class="team-review-heading">
    <div class="team-review-title">
      <p class="eyebrow">{teamContent.eyebrow[lang]}</p>
      <PageTitle
        zh={teamContent.headline.zh}
        en={teamContent.headline.en}
        lang={lang}
      />
    </div>
    <p>
      {teamContent.intro[lang].map((paragraph) => (
        <span class="intro-paragraph">{paragraph}</span>
      ))}
    </p>
  </div>
  <div class="team-explorer">
    <div class="team-portraits">
      {members.map((person) => (
        <article class="team-member" data-team-member={person.id}>
          <button
            class="profile-toggle member-portrait"
            data-image-holder
            data-image-label={pick(lang, person.name, person.en)}
            data-person={person.id}
            aria-controls={`profile-${person.id}`}
            aria-expanded="false"
            aria-label={`${pick(lang, person.name, person.en)} · ${ui[lang].expand}`}
          >
            <img
              src={person.imageUrl}
              width="440"
              height="640"
              alt={pick(lang, person.name, person.en)}
            />
            <span class="member-caption">
              <strong>{pick(lang, person.name, person.en)}</strong>
              <span>{person.role[lang]}</span>
            </span>
          </button>
          <div
            class="member-bio team-bio"
            id={`profile-${person.id}`}
            data-person-bio={person.id}
            aria-live="polite"
            tabindex="0"
            aria-keyshortcuts="Escape"
            title={ui[lang].close}
            hidden
          >
            <div class="team-bio-identity">
              <h2>{pick(lang, person.name, person.en)}</h2>
              <p class="member-en">{pick(lang, person.en, person.name)}</p>
            </div>
            <div class="team-bio-summary">
              <p class="member-role">
                {person.role[lang]} / {person.role[lang === 'zh' ? 'en' : 'zh']}
              </p>
              <p class="member-summary">{person.summary[lang]}</p>
              <div class="member-copy-group">
                {person.bio[lang].split(/\n+/).map((paragraph: string) => (
                  <p class="member-copy">{paragraph}</p>
                ))}
              </div>
            </div>
          </div>
          <noscript>
            <a href={pageUrl(lang, `team-${person.slug}`)}>
              {ui[lang].profile} ↗
            </a>
          </noscript>
        </article>
      ))}
    </div>
  </div>
</section>
<script src="../scripts/team.ts"></script>

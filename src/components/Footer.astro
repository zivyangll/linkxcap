---
import { pageUrl, ui, socials, siteContent, type Lang } from '../lib/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-main">
    <p>{siteContent.copyright[lang]}</p>
    <div class="footer-links">
      <a href={`mailto:${siteContent.email}`}>{siteContent.email}</a>
      <a href={pageUrl(lang, 'legal')}>{ui[lang].legal}</a>
    </div>
  </div>
  <div class="footer-meta">
    <span>{siteContent.companyLegalName[lang]}</span>
    <a
      href="https://beian.miit.gov.cn/"
      target="_blank"
      rel="noopener noreferrer"
    >
      {siteContent.recordNumber}
    </a>
    <div class="social-links">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer">
          {lang === 'en' ? s.en || s.name : s.name}
        </a>
      ))}
    </div>
  </div>
</footer>

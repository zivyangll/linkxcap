---
import {
  pageUrl,
  ui,
  socials,
  contactContent,
  siteContent,
  currentYear,
  type Lang,
} from '../lib/site';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const [copyrightBefore, copyrightAfter] =
  siteContent.footerCopyright[lang].split('{year}');
---

<footer class="site-footer">
  <div class="footer-main">
    <div>
      <p>{siteContent.footerTagline[lang]}</p>
      <p>
        {copyrightBefore}
        <time data-current-year>{currentYear}</time>
        {copyrightAfter}
      </p>
    </div>
    <div class="footer-links">
      <a href={`mailto:${siteContent.email}`}>{siteContent.email}</a>
      <a href={pageUrl(lang, 'legal')}>{ui[lang].legal}</a>
    </div>
  </div>
  <div class="footer-meta">
    <a
      href="https://beian.miit.gov.cn/"
      target="_blank"
      rel="noopener noreferrer"
    >
      {siteContent.recordNumber}
    </a>
    <div class="social-links">
      <a href={pageUrl(lang, 'contact') + '#contact-details'}>
        {contactContent.wechat[0].title[lang]}
      </a>
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener noreferrer">
          {lang === 'en' ? s.en || s.name : s.name}
        </a>
      ))}
    </div>
  </div>
</footer>

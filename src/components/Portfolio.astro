---
import {
  companies,
  sectors,
  homeContent,
  portfolioContent,
  pageUrl,
  type Lang,
} from '../lib/site';
import PageTitle from './PageTitle.astro';
import CompanyLogo from './CompanyLogo.astro';
import Arrow from './Arrow.astro';
const { lang } = Astro.props as { lang: Lang };
---

<div class="portfolio-page" data-node-id="2002:526">
  <PageTitle
    zh={portfolioContent.title.zh}
    en={
      lang === 'zh'
        ? portfolioContent.title.figmaZhEnglish
        : portfolioContent.title.en
    }
    lang={lang}
  />
  <p class="portfolio-intro">
    {portfolioContent.intro[lang].split(/(?<=[，,])\s*/).map((line, index) => (
      <>
        {index > 0 && <br />}
        <span class="portfolio-intro-line">{line}</span>
      </>
    ))}
  </p>
  <nav
    class="portfolio-filters"
    aria-label={homeContent.focus.ariaLabel[lang]}
    data-portfolio-filters
  >
    <button type="button" data-portfolio-filter="all" aria-pressed="true">
      {lang === 'zh' ? '全部' : 'All'}
    </button>
    {sectors.map((sector) => (
      <>
        <span aria-hidden="true">/</span>
        <button
          type="button"
          data-portfolio-filter={sector.id}
          aria-pressed="false"
        >
          {lang === 'zh' ? sector.zh : sector.en}
        </button>
      </>
    ))}
  </nav>
  <div class="portfolio-grid">
    {companies.map((company) => (
      <a
        href={pageUrl(lang, `portfolio/${company.slug}`)}
        class:list={['portfolio-card', { 'is-missing-logo': !company.hasLogo }]}
        aria-label={lang === 'zh' ? company.name : company.nameEn}
        data-company-card
        data-slug={company.slug}
        data-sector={company.sector}
        data-sectors={company.sectorIds.join(' ')}
      >
        <CompanyLogo company={company} />
        <span class="card-corners" aria-hidden="true"></span>
        <span class="card-arrow" aria-hidden="true">
          <Arrow />
        </span>
        <div class="company-caption">
          <span></span>
          <h2>{lang === 'zh' ? company.name : company.nameEn}</h2>
          <p>
            {lang === 'zh'
              ? sectors.find((s) => s.id === company.sector)?.zh
              : sectors.find((s) => s.id === company.sector)?.en}
          </p>
        </div>
      </a>
    ))}
  </div>
  <p class="portfolio-action-hint">{portfolioContent.actionHint[lang]}</p>
</div>
<script src="../scripts/portfolio-filter.ts"></script>

---
import { companies, pageUrl, pick, ui, type Lang } from '../lib/site';
import CompanyLogo from './CompanyLogo.astro';
const { lang } = Astro.props as { lang: Lang };
const positions = [
  [50, 21],
  [69, 12],
  [29, 13],
  [14, 38],
  [45, 49],
  [86, 63],
  [22, 70],
  [13, 12],
  [32, 39],
  [86, 17],
  [10, 88],
  [42, 80],
  [67, 69],
  [68, 39],
  [8, 62],
  [82, 91],
  [58, 91],
  [90, 40],
  [28, 94],
].map(([x, y]) => ({ x, y }));
---

<section class="portfolio-network" data-topology data-topology-kind="portfolio">
  <div class="network-heading">
    <p class="eyebrow">LINK-X CONSTELLATION</p>
    <h1>
      {pick(lang, '投资组合', 'Portfolio')}
      <span>{pick(lang, 'Portfolio', 'Defining what comes next')}</span>
    </h1>
    <p>
      {pick(
        lang,
        '悬停点亮星群，点击探索定义者。',
        'Illuminate a node. Discover the people defining what comes next.',
      )}
    </p>
  </div>
  <div class="network-stage">
    <canvas class="topology-canvas" aria-hidden="true"></canvas>
    <div class="network-nodes">
      {companies.map((company, i) => (
        <a
          href={pageUrl(lang, `portfolio/${company.slug}`)}
          class="network-node"
          data-node3d
          data-company-card
          data-slug={company.slug}
          style={`--nx:${positions[i].x}%;--ny:${positions[i].y}%`}
          aria-label={pick(lang, company.name, company.nameEn)}
        >
          <span class="network-logo">
            <CompanyLogo company={company} />
          </span>
          <span>{pick(lang, company.name, company.nameEn)}</span>
          <small>{String(i + 1).padStart(2, '0')}</small>
        </a>
      ))}
    </div>
  </div>
  <div class="network-bottom">
    <a href={pageUrl(lang, 'contact')}>
      {pick(lang, '与我们连接', 'Connect with us')} ↗
    </a>
    <button
      data-motion-toggle
      data-pause={ui[lang].pause}
      data-resume={ui[lang].resume}
      aria-pressed="false"
    >
      {ui[lang].pause}
    </button>
  </div>
</section>

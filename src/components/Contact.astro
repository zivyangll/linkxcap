---
import {
  contactContent,
  siteContent,
  socials,
  asset,
  url,
  fellowMedia,
  type Lang,
} from '../lib/site';
import Arrow from './Arrow.astro';
const mediaUrl = (src: string) =>
  /^(https?:)?\/\//.test(src) ? src : url(src);
const { lang } = Astro.props as { lang: Lang };
const media = {
  src: fellowMedia.videoUrl,
  poster: fellowMedia.posterUrl,
};
---

<section
  class="story-scene next-signal fellow-intro"
  data-node-id="2002:1617"
  aria-labelledby="next-title"
>
  <div class="signal-guides signal-guides--opening" aria-hidden="true">
    {[247, 389.6, 1531.4, 1681].map((x, i) => (
      <img
        class="signal-guide-v"
        src={asset('1617', i === 0 || i === 3 ? 'imgVector32' : 'imgVector45')}
        style={`left:calc(${x} * var(--u));height:calc(${i === 0 || i === 3 ? 1090 : 1378.254} * var(--u));width:calc(${i === 0 || i === 3 ? 10 : 12.64} * var(--u));`}
        alt=""
      />
    ))}
    {[437.32, 467.66, 525.83, 549.85, 585.25, 678.82].map((y) => (
      <img
        class="signal-guide-h"
        src={asset('1617', y === 467.66 ? 'imgVector44' : 'imgVector34')}
        style={`top:calc(${y} * var(--u));`}
        alt=""
      />
    ))}
  </div>
  <div class="signal-guides signal-guides--context" aria-hidden="true">
    {[247, 389.6, 1531.4, 1681].map((x, i) => (
      <img
        class="signal-guide-v"
        src={asset('1753', i === 0 || i === 3 ? 'imgVector32' : 'imgVector45')}
        style={`left:calc(${x} * var(--u));height:calc(${i === 0 || i === 3 ? 1090 : 1378.254} * var(--u));width:calc(${i === 0 || i === 3 ? 10 : 12.64} * var(--u));`}
        alt=""
      />
    ))}
  </div>
  <img
    class="next-title-outline"
    src={asset('1617', 'imgTheNextSignal')}
    width="761"
    height="116"
    alt=""
    aria-hidden="true"
  />
  <h1 id="next-title" class="next-title-fill">
    {contactContent.signalTitle}
  </h1>
  {lang === 'zh' ? (
    <>
      <img
        class="next-zh next-zh-outline next-subtitle-outline"
        src={asset('1617', 'img')}
        width="584"
        height="95"
        alt={contactContent.signalSubtitle.zh}
      />
      <img
        class="next-zh next-zh-fill next-subtitle-fill"
        src={asset('1692', 'img')}
        width="584"
        height="95"
        alt=""
        aria-hidden="true"
      />
    </>
  ) : (
    <>
      <p
        class="next-en next-en-outline next-subtitle-outline"
        aria-hidden="true"
      >
        {contactContent.signalSubtitle.en}
      </p>
      <p class="next-en next-en-fill next-subtitle-fill">
        {contactContent.signalSubtitle.en}
      </p>
    </>
  )}
  <div class="fellow-context" data-node-id="2002:1753">
    <p>{contactContent.joinCopy[lang]}</p>
    {lang === 'zh' && <p lang="en">{contactContent.joinCopy.en}</p>}
    <i class="fellow-context-marker" aria-hidden="true"></i>
  </div>
  <p class="fellow-definition">{contactContent.definition[lang]}</p>
  <img
    class="next-orbit next-orbit-raster"
    src={asset('audit', '1751')}
    width="1920"
    height="430"
    alt=""
    loading="lazy"
  />
</section>

<section
  class="fellow-media-section"
  data-fellow-media
  data-node-id="2002:1811"
>
  <div class="fellow-media-guides" aria-hidden="true">
    {[247, 389.6, 1531.4, 1681].map((x, i) => (
      <img
        src={asset('1811', i === 0 || i === 3 ? 'imgVector32' : 'imgVector45')}
        class="fellow-media-guide"
        style={`left:calc(${x} * var(--u));height:calc(${i === 0 || i === 3 ? 1090 : 1378.254} * var(--u));width:calc(${i === 0 || i === 3 ? 10 : 12.64} * var(--u));`}
        alt=""
      />
    ))}
  </div>
  <img
    class="fellow-media-orbit"
    src={asset('1811', 'imgEllipse1')}
    width="2406"
    height="2406"
    alt=""
    aria-hidden="true"
  />
  <div class="fellow-media-title">
    <h2>{contactContent.signalTitle}</h2>
    <p>{contactContent.signalSubtitle[lang]}</p>
  </div>
  <div class="fellow-video-shell" data-video-shell>
    {media.src ? (
      <video
        data-fellow-video
        muted
        playsinline
        loop
        preload="none"
        poster={media.poster || undefined}
        controls
      >
        <source src={mediaUrl(media.src)} type="video/mp4" />
      </video>
    ) : (
      <div class="fellow-video-placeholder">
        <span class="fellow-play" aria-hidden="true">
          <img
            src={asset('1811', 'imgEllipse16')}
            width="117"
            height="117"
            alt=""
          />
          <img
            src={asset('1811', 'imgRectangle636')}
            width="41"
            height="46"
            alt=""
          />
        </span>
        <p>{contactContent.videoPlaceholder[lang]}</p>
      </div>
    )}
    <button class="fellow-video-play" data-video-play hidden>
      {contactContent.playVideo[lang]}
    </button>
  </div>
  <p class="fellow-media-caption">{contactContent.joinCopy[lang]}</p>
</section>
<section class="contact-hero" data-node-id="2002:2021">
  <div class="contact-guides" aria-hidden="true">
    {[
      [247, 'imgVector33', 1096, 533],
      [1681, 'imgVector32', 1096, 533],
      [390, 'imgVector45', 1224, 468.94],
      [1531, 'imgVector46', 1224, 468.94],
    ].map(([x, key, h, y]) => (
      <img
        src={asset('2021', String(key))}
        style={`left:calc(${x}*var(--u));top:calc(${y}*var(--u));height:calc(${Number(h) * 1.0074}*var(--u));width:calc(${Number(h) === 1096 ? 10 : 11.168}*var(--u));`}
        alt=""
      />
    ))}
  </div>
  <div class="contact-invitation">
    <h2>
      {contactContent.joinEyebrow}
      {lang === 'zh' && <span>{contactContent.joinTitle.zh}</span>}
    </h2>
    <div class="contact-copy">
      <p>
        {contactContent.joinDisplay[lang].map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </p>
      {lang === 'zh' && <p lang="en">{contactContent.joinCopy.en}</p>}
    </div>
    <a class="line-link" href="#contact-details">
      {contactContent.contactLink}
      <Arrow />
    </a>
  </div>
</section>
<section id="contact-details" class="contact-details">
  <div>
    <p class="eyebrow">{contactContent.detailsEyebrow}</p>
    <h2>{contactContent.detailsTitle[lang]}</h2>
    <a class="contact-email" href={`mailto:${siteContent.email}`}>
      {siteContent.email}
      <Arrow />
    </a>
    <button class="text-link" data-copy={siteContent.email}>
      {contactContent.copyEmail[lang]}
    </button>
  </div>
  <div class="contact-socials">
    <h3>{contactContent.findUs[lang]}</h3>
    {socials.map((s) => (
      <a href={s.href} target="_blank" rel="noopener noreferrer">
        {lang === 'en' ? s.en || s.name : s.name}
        <Arrow />
      </a>
    ))}
    {contactContent.wechat.map((item) => (
      <details>
        <summary>{item.title[lang]}</summary>
        <p>{item.pending[lang]}</p>
      </details>
    ))}
  </div>
</section>

<script>
  import('../scripts/fellow').then((module) => module.initFellow());
</script>

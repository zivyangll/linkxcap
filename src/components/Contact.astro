---
import { join, pick, socials, asset, url, type Lang } from '../lib/site';
import Arrow from './Arrow.astro';
import media from '../data/fellow-media.json';
const mediaUrl = (src: string) =>
  /^(https?:)?\/\//.test(src) ? src : url(src);
const { lang } = Astro.props as { lang: Lang };
---

<section
  class="story-scene next-signal fellow-intro"
  data-node-id="2002:1692"
  aria-labelledby="next-title"
>
  <div class="signal-guides" aria-hidden="true">
    {[247, 389.6, 1531.4, 1681].map((x, i) => (
      <img
        class="signal-guide-v"
        src={asset('1692', i === 0 || i === 3 ? 'imgVector32' : 'imgVector45')}
        style={`left:calc(${x} * var(--u));height:calc(${i === 0 || i === 3 ? 1090 : 1378.254} * var(--u));width:calc(${i === 0 || i === 3 ? 10 : 12.64} * var(--u));`}
        alt=""
      />
    ))}
    {[437.32, 467.66, 525.83, 549.85, 585.25, 678.82].map((y) => (
      <img
        class="signal-guide-h"
        src={asset('1692', y === 467.66 ? 'imgVector44' : 'imgVector34')}
        style={`top:calc(${y} * var(--u));`}
        alt=""
      />
    ))}
  </div>
  <h1 id="next-title">The Next Signal</h1>
  {lang === 'zh' ? (
    <img
      class="next-outline"
      src={asset('1692', 'img')}
      width="584"
      height="95"
      alt="与定义者同行"
      loading="lazy"
    />
  ) : (
    <p class="next-en">Alongside the visionaries</p>
  )}
  <div class="fellow-context" data-node-id="2002:1753">
    <p>{join[lang]}</p>
    {lang === 'zh' && <p lang="en">{join.en}</p>}
  </div>
  <i class="fellow-orbit-point diamond" aria-hidden="true"></i>
  <p class="fellow-definition">
    {pick(
      lang,
      '与定义同行，与定义者同行',
      'Alongside ideas. Alongside their visionaries.',
    )}
  </p>
  <img
    class="next-orbit next-orbit-raster"
    src={asset('audit', '1751')}
    width="1920"
    height="430"
    alt=""
    loading="lazy"
  />
</section>

<section
  class="fellow-media-section"
  data-fellow-media
  data-node-id="2002:1811"
>
  <div class="fellow-media-title">
    <h2>The Next Signal</h2>
    <p>{pick(lang, '与定义者同行', 'Alongside the visionaries')}</p>
  </div>
  <div class="fellow-video-shell" data-video-shell>
    {media.src ? (
      <video
        data-fellow-video
        muted
        playsinline
        loop
        preload="none"
        poster={media.poster ? mediaUrl(media.poster) : undefined}
        controls
      >
        <source src={mediaUrl(media.src)} type="video/mp4" />
        {media.captionsZh && (
          <track
            kind="captions"
            srclang="zh"
            label="中文"
            src={mediaUrl(media.captionsZh)}
            default={lang === 'zh'}
          />
        )}
        {media.captionsEn && (
          <track
            kind="captions"
            srclang="en"
            label="English"
            src={mediaUrl(media.captionsEn)}
            default={lang === 'en'}
          />
        )}
      </video>
    ) : (
      <div
        class="fellow-video-placeholder"
        role="img"
        aria-label={pick(
          lang,
          '品牌视频占位，正式视频待提供',
          'Brand film placeholder — final video pending',
        )}
      >
        <span class="fellow-play" aria-hidden="true">
          <img
            src={asset('1811', 'imgEllipse16')}
            width="117"
            height="117"
            alt=""
          />
          <img
            src={asset('1811', 'imgRectangle636')}
            width="41"
            height="46"
            alt=""
          />
        </span>
        <p>{pick(lang, '品牌视频 · 待提供', 'Brand film · Coming soon')}</p>
      </div>
    )}
    <button class="fellow-video-play" data-video-play hidden>
      {pick(lang, '播放视频', 'Play film')}
    </button>
  </div>
  <p class="fellow-media-caption">{join[lang]}</p>
</section>
<section class="contact-hero" data-node-id="2002:2021">
  <div class="contact-guides" aria-hidden="true">
    {[
      [247, 'imgVector33', 1096, 533],
      [1681, 'imgVector32', 1096, 533],
      [390, 'imgVector45', 1224, 468.94],
      [1531, 'imgVector46', 1224, 468.94],
    ].map(([x, key, h, y]) => (
      <img
        src={asset('2021', String(key))}
        style={`left:calc(${x}*var(--u));top:calc(${y}*var(--u));height:calc(${Number(h) * 1.0074}*var(--u));width:calc(${Number(h) === 1096 ? 10 : 11.168}*var(--u));`}
        alt=""
      />
    ))}
  </div>
  <div class="contact-invitation">
    <h2>Join Us{lang === 'zh' && <span>加入我们</span>}</h2>
    <div class="contact-copy">
      <p>
        {lang === 'zh' ? (
          <>
            如果你正在寻找、定义，或亲手建造一个
            <br />
            尚未被市场命名的未来，我们希望更早与你相遇。
          </>
        ) : (
          join.en
        )}
      </p>
      {lang === 'zh' && <p lang="en">{join.en}</p>}
    </div>
    <a class="line-link" href="#contact-details">
      Contact us
      <Arrow />
    </a>
  </div>
</section>
<section id="contact-details" class="contact-details">
  <div>
    <p class="eyebrow">BUILD WITH US</p>
    <h2>{pick(lang, '连接下一个信号', 'Connect with the next signal')}</h2>
    <a class="contact-email" href="mailto:service@linkxcap.com">
      service@linkxcap.com
      <Arrow />
    </a>
    <button class="text-link" data-copy="service@linkxcap.com">
      {pick(lang, '复制邮箱', 'Copy email')}
    </button>
  </div>
  <div class="contact-socials">
    <h3>{pick(lang, '找到我们', 'Find us')}</h3>
    {socials.map((s) => (
      <a href={s.href} target="_blank" rel="noopener noreferrer">
        {lang === 'en' ? s.en || s.name : s.name}
        <Arrow />
      </a>
    ))}
    <details>
      <summary>
        {pick(lang, '微信 · 星连资本', 'WeChat · Link-X Capital')}
      </summary>
      <p>
        {pick(
          lang,
          '公众号二维码待提供，请先通过邮箱与我们联系。',
          'The official QR code will be added after confirmation. Please contact us by email.',
        )}
      </p>
    </details>
    <details>
      <summary>
        {pick(lang, '微信 · 华清普智孵化器', 'WeChat · T-ONE Innovation Lab')}
      </summary>
      <p>
        {pick(
          lang,
          '公众号二维码待提供，请先通过邮箱与我们联系。',
          'The official QR code will be added after confirmation. Please contact us by email.',
        )}
      </p>
    </details>
  </div>
</section>

<script>
  import('../scripts/fellow').then((module) => module.initFellow());
</script>

---
import Brand from './Brand.astro';
import Arrow from './Arrow.astro';
import {
  navigation,
  navigationContent,
  siteContent,
  pageUrl,
  contactUrl,
  ui,
  contactContent,
  socials,
  asset,
  contentAsset,
  type Lang,
} from '../lib/site';
interface Props {
  lang: Lang;
  current: string;
}
const { lang, current } = Astro.props;
const active =
  current === 'portfolio' || current.startsWith('portfolio/')
    ? 'portfolio'
    : current.startsWith('team')
      ? 'team'
      : ['index', 'legal', 'fellowship'].includes(current)
        ? current
        : 'insights';
// Contact is available in the menu rather than a separate page.
const navItems = navigation.filter((item) => item.page !== 'contact');
const [copyrightBefore, copyrightAfter] =
  siteContent.footerCopyright[lang].split('{year}');
// The menu keeps only the company line: "© 2026 北京…有限责任公司。"
const companyEnd = copyrightAfter.indexOf('。');
const menuCopyrightAfter =
  companyEnd >= 0 ? copyrightAfter.slice(0, companyEnd + 1) : copyrightAfter;
const socialByUrl = (fragment: string) =>
  socials.find((social) => social.href.includes(fragment))!;
const menuSocials = [
  {
    name: contactContent.wechat[0].title.zh,
    en: contactContent.wechat[0].title.en,
    key: '54',
    href: contentAsset(contactContent.wechat[0].imageFile),
  },
  { ...socialByUrl('xhslink.com'), key: '55' },
  { ...socialByUrl('douyin.com'), key: '56' },
  { ...socialByUrl('x.com'), key: '57' },
  { ...socialByUrl('linkedin.com'), key: '58' },
];
---

<a class="skip-link" href="#main">
  {ui[lang].skip}
</a>
<header class="site-header" data-header>
  <a class="home-link" href={pageUrl(lang)} aria-label={siteContent.brand}>
    <Brand />
  </a>
  <div
    class="language-switch"
    aria-label={navigationContent.languageLabel[lang]}
  >
    <a
      href={pageUrl('en', current)}
      data-language="en"
      aria-current={lang === 'en' ? 'page' : undefined}
    >
      {navigationContent.languageShort.en}
    </a>
    <a
      href={pageUrl('zh', current)}
      data-language="zh"
      aria-current={lang === 'zh' ? 'page' : undefined}
    >
      {navigationContent.languageShort.zh}
    </a>
  </div>
  <nav class="desktop-nav" aria-label={navigationContent.mainNavLabel[lang]}>
    {navItems.map((item) => (
      <a
        href={pageUrl(lang, item.page)}
        aria-current={active === item.page ? 'page' : undefined}
        aria-label={lang === 'zh' ? item.zh : item.en}
      >
        {lang === 'zh' ? item.zh : item.en}
      </a>
    ))}
  </nav>
  <button
    class="menu-toggle"
    aria-label={ui[lang].menu}
    aria-controls="site-menu"
    aria-expanded="false"
    data-menu-open
  >
    <span></span>
    <span></span>
  </button>
</header>
<dialog id="site-menu" class="site-menu" aria-label={ui[lang].menu}>
  <div class="menu-top">
    <span>{ui[lang].menu}</span>
    <button data-menu-close aria-label={ui[lang].close} class="menu-close">
      <img src={asset('3191', 'imgGroup382')} width="22" height="22" alt="" />
    </button>
  </div>
  <nav aria-label={navigationContent.menuNavLabel[lang]}>
    {navItems.map((item) => (
      <a
        href={pageUrl(lang, item.page)}
        aria-current={active === item.page ? 'page' : undefined}
        data-h5-label={
          lang === 'zh' && item.page === 'fellowship' ? '伙伴' : undefined
        }
      >
        <i class="menu-current diamond" aria-hidden="true"></i>
        {/* Figma 100:261: English name first, Chinese after it. */}
        <span lang="en">{item.en}</span>
        {lang === 'zh' && item.zh !== item.en && (
          <small lang="zh">{item.zh}</small>
        )}
        <Arrow />
      </a>
    ))}
  </nav>
  <div class="menu-footer">
    <div class="menu-contact">
      <h2>
        {navigationContent.menuContactTitle[lang]
          .split('\n')
          .map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
      </h2>
      <div class="menu-invitation">
        <p>{contactContent.joinCopy[lang]}</p>
        {lang === 'zh' && <p lang="en">{contactContent.joinCopy.en}</p>}
      </div>
      <a class="line-link" href={contactUrl()}>
        <span class="menu-contact-link-label">
          {navigationContent.menuContactLink[lang]}
        </span>
        <Arrow />
      </a>
    </div>
    {/* Same switch as the header: "EN 中", the current language at full strength. */}
    <div class="menu-language">
      <a
        href={pageUrl('en', current)}
        data-language="en"
        aria-current={lang === 'en' ? 'page' : undefined}
      >
        {navigationContent.languageShort.en}
      </a>
      <a
        href={pageUrl('zh', current)}
        data-language="zh"
        aria-current={lang === 'zh' ? 'page' : undefined}
      >
        {navigationContent.languageShort.zh}
      </a>
    </div>
    <div class="menu-bottom">
      <div class="social-links">
        {menuSocials.map((s) => (
          <a
            class={`menu-social social-${s.key}`}
            href={s.href}
            aria-label={lang === 'en' ? s.en : s.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <img
              class="social-circle"
              src={asset(
                '3191',
                s.key === '58' ? 'imgGroup384' : 'imgEllipse7',
              )}
              width="28"
              height="28"
              alt=""
            />
            <span>
              <img
                src={asset('3191', 'imgImage' + s.key)}
                alt=""
                width="20"
                height="20"
              />
            </span>
          </a>
        ))}
      </div>
    </div>
    <div class="menu-legal">
      <p class="menu-copyright">
        {copyrightBefore}
        <time data-current-year></time>
        {menuCopyrightAfter}
      </p>
      <div class="menu-legal-links">
        <a href={`mailto:${siteContent.email}`}>{siteContent.email}</a>
        <a href={pageUrl(lang, 'legal')}>{ui[lang].legal}</a>
        <a
          href="https://beian.miit.gov.cn/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {siteContent.recordNumber}
        </a>
      </div>
    </div>
  </div>
</dialog>
<noscript>
  <nav class="noscript-nav">
    {navigation.map((item) => (
      <a
        href={item.page === 'contact' ? contactUrl() : pageUrl(lang, item.page)}
      >
        {lang === 'zh' ? item.zh : item.en}
      </a>
    ))}
  </nav>
</noscript>

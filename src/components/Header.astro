---
import Brand from './Brand.astro';
import Arrow from './Arrow.astro';
import {
  navigation,
  pageUrl,
  ui,
  join,
  socials,
  asset,
  type Lang,
} from '../lib/site';
interface Props {
  lang: Lang;
  current: string;
  minimal?: boolean;
}
const { lang, current, minimal = false } = Astro.props;
const active = current.startsWith('portfolio')
  ? 'portfolio'
  : current.startsWith('team')
    ? 'team'
    : current === 'index' || current === 'contact' || current === 'legal'
      ? current
      : 'insights';
---

<a class="skip-link" href="#main">
  {ui[lang].skip}
</a>
<header class:list={['site-header', { 'is-minimal': minimal }]} data-header>
  <a class="home-link" href={pageUrl(lang)} aria-label="Link-X Capital">
    <Brand />
  </a>
  <div class="language-switch" aria-label={lang === 'zh' ? '语言' : 'Language'}>
    <a
      href={pageUrl('en', current)}
      data-language="en"
      aria-current={lang === 'en' ? 'page' : undefined}
    >
      EN
    </a>
    <a
      href={pageUrl('zh', current)}
      data-language="zh"
      aria-current={lang === 'zh' ? 'page' : undefined}
    >
      中
    </a>
  </div>
  <nav
    class="desktop-nav"
    aria-label={lang === 'zh' ? '主导航' : 'Main navigation'}
  >
    {navigation.map((item) => (
      <a
        href={pageUrl(lang, item.page)}
        aria-current={active === item.page ? 'page' : undefined}
        aria-label={lang === 'zh' ? `${item.en} · ${item.zh}` : item.en}
      >
        {item.en}
      </a>
    ))}
  </nav>
  <button
    class="menu-toggle"
    aria-label={ui[lang].menu}
    aria-controls="site-menu"
    aria-expanded="false"
    data-menu-open
  >
    <span></span>
    <span></span>
  </button>
</header>
<dialog id="site-menu" class="site-menu" aria-label={ui[lang].menu}>
  <div class="menu-top">
    <span>Menu</span>
    <button data-menu-close aria-label={ui[lang].close} class="menu-close">
      <img src={asset('3191', 'imgGroup382')} width="22" height="22" alt="" />
    </button>
  </div>
  <nav aria-label={lang === 'zh' ? '菜单导航' : 'Menu navigation'}>
    {navigation.slice(0, 4).map((item) => (
      <a
        href={pageUrl(lang, item.page)}
        aria-current={active === item.page ? 'page' : undefined}
      >
        <i class="menu-current diamond" aria-hidden="true"></i>
        <span>{item.en}</span>
        {lang === 'zh' && <small>{item.zh}</small>}
        <Arrow />
      </a>
    ))}
  </nav>
  <div class="menu-contact">
    <h2>
      {lang === 'zh' && (
        <>
          联系我们
          <br />
        </>
      )}
      Build with us
    </h2>
    <div class="menu-invitation">
      <p>{join[lang]}</p>
      {lang === 'zh' && <p lang="en">{join.en}</p>}
    </div>
    <a class="line-link" href={pageUrl(lang, 'contact')}>
      Contact us
      <Arrow />
    </a>
  </div>
  <div class="menu-language">
    <a href={pageUrl('zh', current)} data-language="zh">
      中文
    </a>
    <a href={pageUrl('en', current)} data-language="en">
      English
    </a>
  </div>
  <div class="menu-bottom">
    <div class="social-links">
      {[
        { name: 'X', key: '57', href: socials[0].href },
        {
          name: lang === 'zh' ? '小红书' : 'Xiaohongshu',
          key: '55',
          href: socials[2].href,
        },
        {
          name: lang === 'zh' ? '微信' : 'WeChat',
          key: '54',
          href: pageUrl(lang, 'contact') + '#contact-details',
        },
        {
          name: lang === 'zh' ? '抖音' : 'Douyin',
          key: '56',
          href: socials[3].href,
        },
        { name: 'LinkedIn', key: '58', href: socials[1].href },
      ].map((s) => (
        <a
          class={`menu-social social-${s.key}`}
          href={s.href}
          aria-label={s.name}
          target={s.key === '54' ? undefined : '_blank'}
          rel={s.key === '54' ? undefined : 'noopener noreferrer'}
        >
          <img
            class="social-circle"
            src={asset('3191', s.key === '58' ? 'imgGroup384' : 'imgEllipse7')}
            width="28"
            height="28"
            alt=""
          />
          <span>
            <img
              src={asset('3191', 'imgImage' + s.key)}
              alt=""
              width="20"
              height="20"
            />
          </span>
        </a>
      ))}
    </div>
    <small>2026 北京星连肇基私募基金管理有限责任公司</small>
  </div>
</dialog>
<noscript>
  <nav class="noscript-nav">
    {navigation.map((item) => (
      <a href={pageUrl(lang, item.page)}>{lang === 'zh' ? item.zh : item.en}</a>
    ))}
  </nav>
</noscript>

---
import { render, type CollectionEntry } from 'astro:content';
import {
  pageUrl,
  ui,
  insightsContent,
  type InsightArticle,
  type Lang,
} from '../lib/site';
const { lang, article } = Astro.props as {
  lang: Lang;
  article: InsightArticle & { body: CollectionEntry<'insights'> };
};
const { Content, headings } = await render(article.body);
---

<article class="article-page">
  <a class="text-link" href={pageUrl(lang, 'insights')}>
    ← {insightsContent.back[lang]}
  </a>
  <header class="article-header">
    <p class="eyebrow">
      {insightsContent.eyebrow} / {article.category.toUpperCase()}
    </p>
    <h1>{article.title}</h1>
    <p class="article-summary">{article.summary}</p>
    <p class="article-meta">
      <time datetime={article.date}>{article.date}</time> ·{' '}
      {insightsContent.publisher}
    </p>
  </header>
  <div class="article-layout">
    <nav class="article-toc" aria-label={ui[lang].chapters}>
      <h2>{ui[lang].chapters}</h2>
      {headings
        .filter((h) => h.depth === 2)
        .map((h) => (
          <a href={`#${h.slug}`}>{h.text}</a>
        ))}
    </nav>
    <div class="prose">
      {article.mock && (
        <p class="mock-banner">{insightsContent.mockBanner[lang]}</p>
      )}
      <Content />
      <div class="article-actions">
        <a href={article.source} target="_blank" rel="noopener noreferrer">
          {ui[lang].original} · {article.sourceName} ↗
        </a>
        <button data-copy="">{ui[lang].copy}</button>
      </div>
    </div>
  </div>
</article>

---
import {
  sectors,
  companies,
  homeContent,
  pageUrl,
  pick,
  type Lang,
} from '../lib/site';
import {
  focusHub,
  focusLayout,
  focusBranch,
  mobileFocusHub,
  mobileFocusLayout,
  mobileFocusBranch,
} from '../lib/focus-layout';
const { lang } = Astro.props as { lang: Lang };
const scenes = sectors.map((sector) => {
  const members = companies.filter((company) => company.sector === sector.id);
  return {
    id: sector.id,
    point: focusLayout[sector.id],
    mobile: mobileFocusLayout[sector.id],
    companies: members.map((company, index) => ({
      ...company,
      point: focusBranch(sector.id, index, members.length),
      mobile: mobileFocusBranch(sector.id, index, members.length),
    })),
  };
});
const place = (x: number, y: number, mobile: { x: number; y: number }) =>
  `--sx:${x};--sy:${y};--mx:${(mobile.x / 360) * 100}%;--my:${(mobile.y / 560) * 100}%;`;
---

<div class="constellation" aria-label={homeContent.focus.ariaLabel[lang]}>
  <canvas class="topology-canvas" aria-hidden="true"></canvas>
  <svg
    class="constellation-fallback constellation-fallback--desktop"
    viewBox="0 0 1920 1080"
    aria-hidden="true"
  >
    {scenes.map(({ point }) => (
      <line x1={focusHub.x} y1={focusHub.y} x2={point.x} y2={point.y} />
    ))}
  </svg>
  <svg
    class="constellation-fallback constellation-fallback--mobile"
    viewBox="0 0 360 560"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
  >
    {scenes.map(({ mobile }) => (
      <line
        x1={mobileFocusHub.x}
        y1={mobileFocusHub.y}
        x2={mobile.x}
        y2={mobile.y}
      />
    ))}
  </svg>
  {scenes.map((scene, index) => (
    <div
      class="constellation-scene"
      data-constellation={scene.id}
      hidden={index !== 0}
    >
      <svg
        class="constellation-fallback constellation-fallback--desktop constellation-branches"
        viewBox="0 0 1920 1080"
        aria-hidden="true"
      >
        {scene.companies.map(({ point }) => (
          <line
            x1={scene.point.x}
            y1={scene.point.y}
            x2={point.x}
            y2={point.y}
          />
        ))}
      </svg>
      <svg
        class="constellation-fallback constellation-fallback--mobile constellation-branches"
        viewBox="0 0 360 560"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        {scene.companies.map(({ mobile }) => (
          <line
            x1={scene.mobile.x}
            y1={scene.mobile.y}
            x2={mobile.x}
            y2={mobile.y}
          />
        ))}
      </svg>
      {scene.companies.map((company) => (
        <a
          class="constellation-company"
          data-topology-anchor={`company-${company.id}`}
          data-topology-role="node"
          data-focus-sector={scene.id}
          data-x={company.point.x}
          data-y={company.point.y}
          data-z={company.point.z}
          data-mx={company.mobile.x}
          data-my={company.mobile.y}
          data-mz={company.mobile.z}
          data-mobile-side={company.mobile.side}
          data-label-side={company.point.side}
          style={place(company.point.x, company.point.y, company.mobile)}
          href={pageUrl(lang, `portfolio/${company.slug}`)}
        >
          <i class="constellation-dot" aria-hidden="true"></i>
          <span class="constellation-company-label">
            {`(${company.investmentYear}, ${pick(lang, company.name, company.nameEn)})`}
          </span>
        </a>
      ))}
    </div>
  ))}
  {sectors.map((sector, index) => {
    const point = focusLayout[sector.id];
    const mobile = mobileFocusLayout[sector.id];
    return (
      <button
        class:list={[
          'sector-star',
          `star-${sector.id}`,
          { 'is-active': index === 0 },
        ]}
        data-sector={sector.id}
        data-topology-anchor={`sector-${sector.id}`}
        data-topology-role="node"
        data-x={point.x}
        data-y={point.y}
        data-z={point.z}
        data-mx={mobile.x}
        data-my={mobile.y}
        data-mz={mobile.z}
        data-mobile-side={mobile.side}
        data-label-side={point.side}
        aria-controls={`sector-${sector.id}`}
        aria-pressed={index === 0}
        style={place(point.x, point.y, mobile)}
      >
        <span class="star-glyph" aria-hidden="true">
          <i class="diamond"></i>
        </span>
        <span class="star-label">
          <span lang="en">{sector.en}</span>
          {lang === 'zh' && <span lang="zh">{sector.zh}</span>}
        </span>
      </button>
    );
  })}
  <i
    class="constellation-hub"
    data-topology-anchor="hub"
    data-topology-role="node"
    data-x={focusHub.x}
    data-y={focusHub.y}
    data-z={focusHub.z}
    data-mx={mobileFocusHub.x}
    data-my={mobileFocusHub.y}
    data-mz={mobileFocusHub.z}
    style={place(focusHub.x, focusHub.y, mobileFocusHub)}
    aria-hidden="true"
  ></i>
</div>

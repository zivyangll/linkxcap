---
import {
  asset,
  sectors,
  companies,
  homeContent,
  pageUrl,
  pick,
  type Lang,
} from '../lib/site';
const { lang } = Astro.props as { lang: Lang };
const positions: Record<string, number[]> = {
  foundation: [1297, 610, 1346, 586, 1297, 610, 1359, 581],
  applications: [1476, 309, 1519, 292, 1476, 308, 1535, 279],
  physical: [1008, 536.5, 1051, 519.52, 994, 539.38, 1048, 509.52],
  infrastructure: [1659, 744, 1691, 735, 1659, 744, 1710, 714],
  frontiers: [1077, 187, 1116, 170, 1077, 187, 1138, 157],
};
const scenes = [
  {
    id: 'foundation',
    node: '3549',
    lines: [
      ['imgVector156', 1324.213, 633.42, 61.69, 81.07, 'rotate(177.67deg)'],
      ['imgVector157', 1038.697, 634.594, 233.606, 169.811, 'scaleY(-1)'],
      ['imgVector158', 1321.511, 633, 47.978, 240, 'none'],
    ],
    satellites: [
      ['zhipu-ai', 890, 804, 1027, 810],
      ['shengshu-technology', 1402, 723, 1392, 719],
      ['modelbest', 1387, 891, 1369, 880],
    ],
  },
  {
    id: 'applications',
    node: '3769',
    lines: [
      ['imgVector156', 1504.213, 333.897, 61.69, 81.07, 'rotate(177.67deg)'],
      ['imgVector157', 1396.546, 332.788, 54.907, 118.425, 'scaleY(-1)'],
      ['imgVector158', 1500.581, 161.722, 79.837, 121.557, 'scaleX(-1)'],
      ['imgVector159', 1272, 281.517, 179, 46.966, 'scaleY(-1)'],
    ],
    satellites: [
      ['realai', 1239, 446, 1390, 454],
      ['tairex', 1582, 423.48, 1572, 419.48],
      ['biogeometry', 1601, 139, 1584, 153],
      ['polo-interactive', 1126, 321, 1262, 330],
    ],
  },
  {
    id: 'physical',
    node: '3883',
    lines: [
      ['imgVector156', 1024.66, 563.427, 49.798, 254.584, 'rotate(177.67deg)'],
      ['imgVector160', 931.637, 359.777, 34.011, 154.515, 'rotate(177.67deg)'],
      ['imgVector157', 900.538, 563.323, 68.925, 164.394, 'scaleY(-1)'],
    ],
    satellites: [
      ['phybot', 742, 728.52, 891, 736.52],
      ['amio-robotics', 1094, 827, 1079, 824.52],
      ['zettlab', 945, 336, 922, 347.52],
    ],
  },
];
const place = (x: unknown, y: unknown) =>
  `left:calc(${x} * var(--u));top:calc(${y} * var(--u));`;
---

<div class="constellation" aria-label={homeContent.focus.ariaLabel[lang]}>
  {scenes.map((scene) => (
    <div
      class="constellation-scene"
      data-constellation={scene.id}
      hidden={scene.id !== 'foundation'}
    >
      {scene.lines.map(([key, x, y, w, h, transform]) => (
        <img
          class="constellation-line"
          src={asset(scene.node, String(key))}
          style={`${place(x, y)}width:calc(${w} * var(--u));height:calc(${h} * var(--u));transform:${transform}`}
          alt=""
          width={Number(w)}
          height={Number(h)}
        />
      ))}
      {scene.satellites.map(([companyId, x, y, dx, dy]) => {
        const company = companies.find((item) => item.id === companyId);
        if (!company) return null;
        const label = `(${homeContent.focus.investmentYear}, ${pick(lang, company.name, company.nameEn)})`;
        return (
          <>
            <a
              class="constellation-company"
              data-topology-anchor={`company-${company.id}`}
              data-topology-role="label"
              style={place(x, y)}
              href={pageUrl(lang, `portfolio/${company.slug}`)}
              set:text={label}
            />
            <i
              class="constellation-dot"
              data-topology-anchor={`company-${company.id}`}
              data-topology-role="node"
              style={place(dx, dy)}
              aria-hidden="true"
            ></i>
          </>
        );
      })}
    </div>
  ))}
  {sectors.map((s, i) => {
    const [x, y, lx, ly, ax, ay, alx, aly] = positions[s.id];
    return (
      <button
        class:list={['sector-star', `star-${s.id}`, { 'is-active': i === 0 }]}
        data-sector={s.id}
        data-topology-anchor={`sector-${s.id}`}
        data-topology-role="node"
        aria-controls={`sector-${s.id}`}
        aria-pressed={i === 0}
        style={`--sx:${x};--sy:${y};--lx:${lx};--ly:${ly};--ax:${ax};--ay:${ay};--alx:${alx};--aly:${aly}`}
      >
        <span class="star-glyph" aria-hidden="true">
          <img
            class="glyph-inactive"
            src={asset('audit', s.id === 'frontiers' ? '3644' : '3617')}
            alt=""
            width="53"
            height="53"
          />
          <img
            class="glyph-active"
            src={asset('audit', '3610')}
            alt=""
            width="102"
            height="102"
          />
          <i class="diamond"></i>
        </span>
        <span class="star-label">
          <span lang="en">{s.en}</span>
          {lang === 'zh' && <span lang="zh">{s.zh}</span>}
        </span>
      </button>
    );
  })}
  <i
    class="constellation-dot quiet-dot"
    data-topology-anchor="quiet"
    data-topology-role="node"
    style={place(1181, 340)}
    aria-hidden="true"
  ></i>
</div>

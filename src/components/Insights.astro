---
import { getCollection } from 'astro:content';
import {
  pageUrl,
  ui,
  insightArticleFromData,
  insightsContent,
  content,
  siteContent,
  type Lang,
} from '../lib/site';
const { lang } = Astro.props as { lang: Lang };
const articles = (await getCollection('insights'))
  .map(({ data }) => insightArticleFromData(data))
  .filter((article) => article.lang === lang)
  .sort((a, b) => a.order - b.order);
const filters = content.insights.filters;
const displayArticles = articles.map((article) => {
  const filter = filters.find(({ id }) => id === article.category);
  return {
    article,
    row: {
      date: article.date,
      labelZh: filter?.zh || article.category,
      labelEn: (filter?.en || article.category).toUpperCase(),
    },
  };
});
const orbitDuration = 72;
const [copyrightBefore, copyrightAfter] =
  siteContent.footerCopyright[lang].split('{year}');
const orbitDots = Array.from({ length: 32 }, (_, index) => {
  const angle = -Math.PI / 2 + (index / 32) * Math.PI * 2;
  const radius = 49.35;
  return {
    x: 50 + Math.cos(angle) * radius,
    y: 50 + Math.sin(angle) * radius,
    delay: -(index / 32) * orbitDuration,
    opacity: 0.22 + ((index * 7) % 11) / 18,
  };
});
---

<section class="insights-page" data-node-id="2002:2833">
  <div class="insights-orbit" aria-hidden="true">
    <div class="insights-orbit-points">
      {orbitDots.map((dot, index) => (
        <i
          class="insights-orbit-dot"
          data-orbit-dot={index}
          style={`--dot-x:${dot.x.toFixed(4)}%;--dot-y:${dot.y.toFixed(4)}%;--dot-delay:${dot.delay.toFixed(3)}s;--dot-rest-opacity:${dot.opacity.toFixed(3)};`}
        ></i>
      ))}
    </div>
  </div>
  <div class="insights-heading">
    <div class="insights-heading-title">
      {lang === 'zh' && <span lang="en">{insightsContent.title.en}</span>}
      <p>{insightsContent.title[lang]}</p>
    </div>
    <div class="insights-heading-copy">
      <h1 class="insights-headline">
        {insightsContent.headline[lang]}
        {lang === 'zh' && <span lang="en">{insightsContent.headline.en}</span>}
      </h1>
      <p class="insights-intro">
        {insightsContent.intro[lang].map((paragraph) => (
          <span class="intro-paragraph">{paragraph}</span>
        ))}
      </p>
    </div>
  </div>
  <div class="insight-list">
    {displayArticles.map(({ article, row }) => {
      const date = new Date(`${row.date}T12:00:00Z`);
      return (
        <article class="insight-row" data-category={article.category}>
          <time class="insight-date" datetime={date.toISOString().slice(0, 10)}>
            {String(date.getUTCDate()).padStart(2, '0')} /
            <small>
              {date.toLocaleDateString('en', {
                month: 'short',
                timeZone: 'UTC',
              })}
            </small>
          </time>
          <h2>
            <a href={pageUrl(lang, article.route)}>
              {lang === 'zh'
                ? article.listTitle || article.title
                : article.title}
            </a>
          </h2>
          <p class="insight-category">
            {lang === 'zh' && <span>{row.labelZh}</span>}
            <span>[ {row.labelEn} ]</span>
          </p>
          <div class="insight-excerpt">
            <p>
              {lang === 'zh'
                ? article.listSummary || article.summary
                : article.summary}
            </p>
            <a
              href={pageUrl(lang, article.route)}
              aria-label={`${ui[lang].more}：${article.title}`}
            >
              {ui[lang].more}
            </a>
          </div>
        </article>
      );
    })}
  </div>
  <p class="insights-copyright">
    {copyrightBefore}
    <time data-current-year></time>
    {copyrightAfter}
  </p>
</section>

<script>
  import '../scripts/insights-motion';
</script>
<style>
  /* Heading follows the Team page: section name on the left, headline and
     intro in a right-hand column (Figma 275:2828 / 275:3880). */
  .insights-heading-title span {
    display: block;
    font-size: 12px;
    letter-spacing: 0.12em;
  }
  .insights-heading-title p {
    font-size: clamp(32px, 8.205vw, 44px);
    font-weight: 600;
    line-height: 1.2;
  }
  .insights-headline {
    margin-top: 32px;
    font-size: clamp(20px, 5vw, 24px);
    font-weight: 600;
    line-height: 1.2;
  }
  .insights-headline span {
    display: block;
  }
  .insights-intro {
    margin-top: 16px;
    max-width: 44rem;
    font-size: 14px;
    line-height: 1.55;
  }
  @media (min-width: 1024px) {
    .insights-heading {
      position: relative;
      height: calc(428 * var(--u));
      margin: calc(-196 * var(--u)) calc(-198 * var(--u)) 0;
    }
    .insights-heading-title {
      position: absolute;
      left: calc(180 * var(--u));
      top: calc(174 * var(--u));
      display: flex;
      flex-direction: column;
      white-space: nowrap;
    }
    .insights-heading-title span {
      margin-bottom: calc(11.92 * var(--u));
      font-size: max(12px, calc(20 * var(--u)));
      font-weight: 500;
      letter-spacing: 0;
      line-height: 1.2;
    }
    .insights-heading-title p {
      font-size: max(12px, calc(60 * var(--u)));
    }
    .insights-heading-copy {
      position: absolute;
      left: calc(1200 * var(--u));
      top: calc(222 * var(--u));
      width: calc(575 * var(--u));
    }
    body[data-lang='en'] .insights-heading-copy {
      left: calc(991 * var(--u));
      top: calc(208 * var(--u));
      width: calc(784 * var(--u));
    }
    .insights-headline {
      margin: 0;
      font-size: max(12px, calc(32 * var(--u)));
      white-space: nowrap;
    }
    .insights-headline span {
      display: none;
    }
    .insights-intro {
      margin-top: calc(11 * var(--u));
      max-width: none;
      font-size: max(12px, calc(14 * var(--u)));
      line-height: 1.5;
      letter-spacing: -0.05em;
    }
    /* Same rhythm as the Team intro: paragraphs follow on at line height. */
    .insights-intro .intro-paragraph + .intro-paragraph {
      margin-top: 0;
    }
  }
  .insights-orbit {
    aspect-ratio: 1;
    border-radius: 50%;
  }
  .insights-orbit-points {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    transform-origin: 50% 50%;
  }
  .insights-orbit-dot {
    position: absolute;
    left: var(--dot-x);
    top: var(--dot-y);
    display: block;
    width: clamp(3px, calc(7 * var(--u)), 8px);
    aspect-ratio: 1;
    border-radius: 1px;
    background: #343331;
    opacity: var(--dot-rest-opacity);
    transform: translate(-50%, -50%);
    transform-origin: 50% 50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .insights-orbit-points {
      animation: insights-orbit-clockwise 72s linear infinite;
      animation-play-state: paused;
    }
    .insights-orbit-dot {
      animation: insights-dot-focus 72s linear var(--dot-delay) infinite;
      animation-play-state: paused;
      will-change: filter, opacity, transform;
    }
    .insights-orbit[data-orbit-running='true'] .insights-orbit-points,
    .insights-orbit[data-orbit-running='true'] .insights-orbit-dot {
      animation-play-state: running;
    }
    @keyframes insights-orbit-clockwise {
      from {
        transform: rotate(0turn);
      }
      to {
        transform: rotate(1turn);
      }
    }
    @keyframes insights-dot-focus {
      0%,
      36%,
      100% {
        filter: blur(0);
        opacity: 0.86;
        transform: translate(-50%, -50%) scale(0.92);
      }
      68% {
        filter: blur(calc(5 * var(--u)));
        opacity: 0.14;
        transform: translate(-50%, -50%) scale(1.75);
      }
      84% {
        filter: blur(calc(3 * var(--u)));
        opacity: 0.3;
        transform: translate(-50%, -50%) scale(1.35);
      }
    }
  }
</style>

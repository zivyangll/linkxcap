---
import {
  pageUrl,
  asset,
  ui,
  insightArticles,
  insightsContent,
  content,
  type Lang,
} from '../lib/site';
const { lang } = Astro.props as { lang: Lang };
const articles = insightArticles
  .filter((article) => article.lang === lang)
  .sort((a, b) => a.order - b.order);
const displayArticles = content.insights.listRows.map((row) => ({
  article: articles.find((article) => article.id === row.article)!,
  row,
}));
const filters = content.insights.filters;
---

<section class="insights-page" data-node-id="2002:2833">
  <img
    class="insights-orbit"
    src={asset('2833', 'imgEllipse9')}
    width="1954"
    height="1954"
    alt=""
    loading="lazy"
  />
  <h1 class="insights-title">
    {insightsContent.title.en}
    {lang === 'zh' && <span>{insightsContent.title.zh}</span>}
  </h1>
  <p class="insights-intro">{insightsContent.intro[lang]}</p>
  <div
    class="insight-filters"
    role="group"
    aria-label={insightsContent.filterLabel[lang]}
  >
    {filters.map(({ id, zh, en }, i) => (
      <>
        {i > 0 && <span aria-hidden="true">/</span>}
        <button data-filter={id} aria-pressed={id === 'all'}>
          {lang === 'zh' ? zh : en}
        </button>
      </>
    ))}
  </div>
  <div class="insight-list">
    {displayArticles.map(({ article, row }) => {
      const date = new Date(`${row.date}T12:00:00Z`);
      return (
        <article class="insight-row" data-category={article.category}>
          <time class="insight-date" datetime={date.toISOString().slice(0, 10)}>
            {String(date.getUTCDate()).padStart(2, '0')} /
            <small>
              {date.toLocaleDateString('en', {
                month: 'short',
                timeZone: 'UTC',
              })}
            </small>
          </time>
          <h2>
            <a href={pageUrl(lang, article.route)}>
              {lang === 'zh'
                ? article.listTitle || article.title
                : article.title}
            </a>
          </h2>
          <p class="insight-category">
            {lang === 'zh' && <span>{row.labelZh}</span>}
            <span>[ {row.labelEn} ]</span>
          </p>
          <div class="insight-excerpt">
            <p>
              {lang === 'zh'
                ? article.listSummary || article.summary
                : article.summary}
            </p>
            <a
              href={pageUrl(lang, article.route)}
              aria-label={`${ui[lang].more}：${article.title}`}
            >
              {ui[lang].more}
            </a>
          </div>
        </article>
      );
    })}
  </div>
  <p class="insights-copyright">{insightsContent.copyright}</p>
  <div class="empty-state" data-empty hidden>
    <p>{ui[lang].noResults}</p>
    <button data-filter-reset>{ui[lang].reset}</button>
  </div>
</section>

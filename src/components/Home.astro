---
import {
  asset,
  contactUrl,
  homeContent,
  sectors,
  url,
  type Lang,
} from '../lib/site';
import FocusConstellation from './FocusConstellation.astro';
import H5FocusConstellation from './H5FocusConstellation.astro';
import PaperTexture from './PaperTexture.astro';
import { initialFocusSector } from '../lib/focus-layout';
import '../styles/home-mobile.css';
import '../styles/focus-constellation.css';
import '../styles/home-backdrop.css';
import '../styles/home-figma.css';
import '../styles/home-h5.css';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// Figma frames: zh shows the English title line above the Chinese one, en
// breaks "First Light" onto two lines, and the body breaks one line per clause.
const openingTitle =
  lang === 'zh'
    ? [
        { text: homeContent.opening.title.en.join(' '), lang: 'en' },
        { text: homeContent.opening.title.zh.join(' '), lang: 'zh' },
      ]
    : homeContent.opening.title.en
        .join(' ')
        .split(' ')
        .map((text) => ({ text, lang: 'en' }));
// en breaks "Backing" onto its own line (three lines in the frame).
const heroLines =
  lang === 'zh' ? homeContent.hero.title.zh : homeContent.hero.title.en;
const h5HeroWords = homeContent.hero.title.en.join(' ').split(/\s+/);
const h5HeroLines = [
  h5HeroWords.slice(0, 2).join(' '),
  h5HeroWords.slice(2, 4).join(' '),
  h5HeroWords.slice(4).join(' '),
];
const h5NorthLines =
  lang === 'zh'
    ? homeContent.about.label.zh.at(-1)!.split('，')
    : homeContent.about.label.en;
const heroLead = lang === 'zh' ? '' : heroLines[0].split(' ')[0];
const heroRest = (line: string, index: number) =>
  lang !== 'zh' && index === 0 ? line.slice(heroLead.length).trim() : line;
// en sets "What We / Invest In" on two lines on desktop only.
const focusWords = homeContent.focus.title.en.join(' ').split(' ');
const focusLead = focusWords.slice(0, 2).join(' ');
const focusRest = focusWords.slice(2).join(' ');
const openingBody = homeContent.opening.body[lang]
  .filter(Boolean)
  .flatMap((line, index) => {
    if (index === 0) return [line];
    const cut = Math.max(line.lastIndexOf('，'), line.lastIndexOf(', '));
    return cut > 0
      ? [line.slice(0, cut + 1).trim(), line.slice(cut + 1).trim()]
      : [line];
  });
---

<noscript>
  <style>
    .focus {
      height: auto;
      min-height: 1100px;
      padding-bottom: 70px;
    }
    .focus-panels {
      position: relative;
      left: auto;
      top: auto;
      width: 85%;
      margin: 650px auto 0;
    }
    .focus-panel {
      display: block !important;
      margin-bottom: 40px;
    }
    @media (max-width: 767px) {
      .focus-panels {
        margin: 440px 0 0;
        width: 100%;
        inset: auto;
      }
    }
  </style>
</noscript>
<div class="home-particles" data-home-particles-layer aria-hidden="true">
  <div class="home-particle-field">
    <canvas data-home-particles data-src={url('assets/particles.bin')}></canvas>
  </div>
</div>
<div class="home-story" data-home data-mobile-static="true">
  <section
    class="story-scene opening"
    data-node-id="2002:3297"
    aria-labelledby="opening-title"
  >
    <PaperTexture eager />
    <canvas
      class="scroll-trail"
      data-scroll-trail="opening"
      aria-hidden="true"
    ></canvas>
    <div class="opening-track" aria-hidden="true">
      <i class="diamond"></i>
      {/* Inline, not an <img>: on a slow network the rail must paint with
          the first frame, not wait in the image queue (Figma 3297 Vector 30). */}
      <svg
        width="2"
        height="590"
        viewBox="0 0 2 590"
        preserveAspectRatio="none"
        fill="none"
      >
        <defs>
          <linearGradient
            id="opening-rail-gradient"
            x1="1.5"
            y1="79"
            x2="1.5"
            y2="590"
            gradientUnits="userSpaceOnUse"
          >
            <stop stop-color="#573C79" />
            <stop offset="1" stop-color="#8C8A9E" />
          </linearGradient>
        </defs>
        <path
          d="M1 0V590"
          stroke="url(#opening-rail-gradient)"
          stroke-width="2"
          stroke-dasharray="4 4"
        />
      </svg>
    </div>
    <span class="chapter">
      <span class="chapter-desktop">{homeContent.opening.chapter.en}</span>
      <span class="chapter-mobile">{homeContent.opening.chapter[lang]}</span>
    </span>
    <h1 id="opening-title" class="opening-title" data-reveal>
      {openingTitle.map((line, index) => (
        <>
          {index > 0 && ' '}
          {index > 0 && <br />}
          <span class="opening-title-line" lang={line.lang}>
            {line.text}
          </span>
        </>
      ))}
    </h1>
    <div class="opening-copy" data-reveal>
      <p>
        {openingBody.map((line, index) => (
          <>
            {index > 0 && ' '}
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </div>
  </section>
  <div class="philosophy-stage" data-philosophy-stage data-minimal-header>
    <PaperTexture />
    <canvas class="philosophy-stage-canvas" aria-hidden="true"></canvas>
    <section
      class="story-scene hero"
      data-node-id="2002:3348"
      data-minimal-header
      aria-labelledby="hero-title"
    >
      <div class="h5-art h5-hero-arc" data-h5-only hidden aria-hidden="true">
        <img
          src={asset('h5-5492', 'imgEllipse1')}
          loading="lazy"
          width="2386"
          height="2386"
          alt=""
        />
      </div>
      <div class="h5-art h5-hero-guide" data-h5-only hidden aria-hidden="true">
        <img
          src={asset('h5-5492', 'imgVector30')}
          loading="lazy"
          width="1"
          height="1080"
          alt=""
        />
      </div>
      <div class="h5-arc-markers" data-h5-only hidden aria-hidden="true">
        <i class="h5-static-node h5-arc-start"></i>
        <i class="h5-rail-end"></i>
        <i class="h5-open-node"></i>
      </div>
      {/* Figma 3348 Ellipse 1: the dashed left arc of the orbit (130.7° to
          278.2°). Inline so it needs no 100 KB raster on a slow network. */}
      <svg
        class="hero-orbit ambient-orbit"
        width="2386"
        height="2386"
        viewBox="0 0 2386 2386"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M428.4 2081.9A1172.5 1172.5 0 0 1 1360.2 32.5"
          stroke="#413F5E"
          stroke-opacity="0.94"
          stroke-dasharray="4 4"
        />
      </svg>
      <div class="hero-track" aria-hidden="true">
        <i class="diamond hero-track-start"></i>
        <i class="diamond hero-track-end"></i>
        <svg
          class="hero-track-line"
          width="2"
          height="1080"
          viewBox="0 0 2 1080"
          preserveAspectRatio="none"
          fill="none"
        >
          <defs>
            <linearGradient
              id="hero-rail-gradient"
              x1="1.5"
              y1="144.61"
              x2="1.5"
              y2="1080"
              gradientUnits="userSpaceOnUse"
            >
              <stop />
              <stop offset="1" stop-color="#9D9D9D" />
            </linearGradient>
          </defs>
          <path
            d="M1 0V1080"
            opacity="0.2"
            stroke="url(#hero-rail-gradient)"
            stroke-width="2"
            stroke-dasharray="4 4"
          />
        </svg>
      </div>
      {lang === 'zh' && (
        <p class="hero-title hero-title-en" lang="en" aria-hidden="true">
          {homeContent.hero.title.en.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )}
      <p
        class="h5-hero-title"
        data-h5-only
        hidden
        lang="en"
        aria-hidden={lang === 'zh' ? 'true' : undefined}
      >
        {h5HeroLines.map((line) => (
          <span>{line}</span>
        ))}
      </p>
      <h2
        id="hero-title"
        class:list={['hero-title', { 'hero-title--zh': lang === 'zh' }]}
        data-reveal
      >
        {heroLines.map((line, index) => (
          <>
            {index > 0 && <br />}
            {index === 0 && heroLead && (
              <>
                {heroLead} <br class="hero-desktop-br" />
              </>
            )}
            {heroRest(line, index)}
          </>
        ))}
      </h2>
      <a class="orbit-label" href="#about">
        <i class="diamond" aria-hidden="true"></i>
        <em class="orbit-label-touch">{homeContent.hero.orbitEyebrow[lang]}</em>
        <span class="orbit-label-touch">
          {homeContent.hero.orbitLabel[lang]}
        </span>
        <span class="orbit-label-desktop" lang="en">
          {homeContent.hero.orbitLabel.en}
        </span>
      </a>
      <a class="h5-open-signal" data-h5-only hidden href="#about">
        <em>open signal</em>
        <span>{homeContent.hero.orbitLabel[lang]}</span>
      </a>
    </section>
    <section
      class="h5-north-star"
      data-h5-only
      hidden
      aria-label={h5NorthLines.join('，')}
    >
      <div class="h5-art h5-bottom-arc" aria-hidden="true">
        <img
          src={asset('h5-5555', 'imgEllipse1')}
          loading="lazy"
          width="2406"
          height="2406"
          alt=""
        />
      </div>
      <div class="h5-art h5-drop-guide" aria-hidden="true">
        <img
          src={asset('h5-5555', 'imgVector30')}
          loading="lazy"
          width="22"
          height="730"
          alt=""
        />
      </div>
      <div class="h5-art h5-tangent-guide" aria-hidden="true">
        <img
          src={asset('h5-5555', 'imgVector31')}
          loading="lazy"
          width="1"
          height="1920"
          alt=""
        />
      </div>
      <i class="h5-static-node h5-north-node" aria-hidden="true"></i>
      {h5NorthLines.map((line) => (
        <p class="h5-north-line">
          <span class="h5-north-soft">{line}</span>
          <span class="h5-north-sharp" aria-hidden="true">
            {line}
          </span>
        </p>
      ))}
    </section>
    <section
      class="story-scene about"
      id="about"
      data-node-id="2002:3438"
      data-minimal-header
      aria-labelledby="about-title"
    >
      <div class="about-decor" aria-hidden="true">
        {[
          ['3474', 0, 1842, 179],
          ['3481', 627, 23, 469],
          ['3482', 628.365, 677, 469],
          ['3483', 0, 648, 469],
        ].map(([id, x, w, h]) => (
          <img
            src={asset('audit', String(id))}
            style={`left:calc(${x}*var(--u));width:calc(${w}*var(--u));height:calc(${h}*var(--u));`}
            width={Number(w)}
            height={Number(h)}
            alt=""
            loading="lazy"
          />
        ))}
      </div>
      <img
        class="about-orbit"
        src={asset('3438', 'imgEllipse1')}
        alt=""
        width="2406"
        height="2406"
        loading="lazy"
      />
      <i class="about-tangent-line" aria-hidden="true"></i>
      <div class="about-rays" aria-hidden="true">
        <i class="about-drop-line"></i>
        <i class="about-ring"></i>
        <span></span>
        <span></span>
        <span></span>
        <i class="diamond"></i>
      </div>
      <div class="about-label">
        {homeContent.about.label[lang].map((text, index) => (
          <>
            {index > 0 && <br />}
            <span class="about-label-line">
              <span class="about-label-soft">{text}</span>
              <span class="about-label-sharp" aria-hidden="true">
                {text}
              </span>
            </span>
          </>
        ))}
      </div>
      <img
        class="about-arc"
        src={asset('audit', '1751')}
        width="1920"
        height="430"
        alt=""
        aria-hidden="true"
        loading="lazy"
      />
      <i class="about-rail" aria-hidden="true"></i>
      <i class="about-node" aria-hidden="true"></i>
      <h2 id="about-title" class="about-title" data-reveal>
        {homeContent.about.title[lang].map((line) => (
          <span>{line}</span>
        ))}
      </h2>
      <p class="about-copy" data-reveal>
        {homeContent.about.description[lang].map((paragraph) => (
          <span class="intro-paragraph">{paragraph}</span>
        ))}
      </p>
      <div class="h5-art h5-about-guide" data-h5-only hidden aria-hidden="true">
        <img
          src={asset('h5-5610', 'imgVector30')}
          loading="lazy"
          width="22"
          height="730"
          alt=""
        />
      </div>
      <i
        class="h5-static-node h5-about-node"
        data-h5-only
        hidden
        aria-hidden="true"
      ></i>
    </section>
  </div>
  <section
    class="story-scene research"
    data-node-id="2002:3487"
    data-minimal-header
    aria-labelledby="research-title"
  >
    <PaperTexture />
    <div class="research-axis" aria-hidden="true">
      <img
        class="research-axis-line"
        src={asset('audit', '3541')}
        width="1616"
        height="41"
        alt=""
      />
      <i class="diamond"></i>
      <img
        class="research-marker"
        src={asset('audit', '3542')}
        width="95"
        height="96"
        alt=""
      />
    </div>
    <h2 id="research-title" data-reveal>
      {homeContent.research.name[lang]}
      <br />
      <span>{homeContent.research.title[lang]}</span>
    </h2>
    <p class="research-intro" data-reveal>
      {homeContent.research.intro[lang].map((paragraph) => (
        <span class="intro-paragraph">{paragraph}</span>
      ))}
    </p>
    <div class="research-stats" data-reveal>
      {homeContent.research.stats.map(({ value, label }) => (
        <div>
          <strong>{value}</strong>
          <span>{label[lang]}</span>
        </div>
      ))}
    </div>
  </section>
  <section
    class="story-scene focus"
    id="focus"
    data-node-id="2002:3549"
    data-minimal-header
    data-dark-header
    data-topology
    data-topology-kind="home"
    data-focus={initialFocusSector}
    aria-labelledby="focus-title"
  >
    <div class="focus-backdrop" aria-hidden="true">
      {/* 540 KB of star noise that no encoder shrinks much. Browsers start
          "lazy" images thousands of pixels early on slow links, so the
          script sets src only when this screen is about to arrive. */}
      <img
        class="focus-backdrop-milky-way"
        src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
        data-defer-src={url('assets/focus-milkyway.webp')}
        width="658"
        height="1068"
        alt=""
        decoding="async"
      />
      <video
        class="focus-backdrop-stars"
        data-focus-stars
        data-src={asset('home-bg', 'focusStarsMp4')}
        poster={asset('home-bg', 'focusStarsPoster')}
        width="1440"
        height="810"
        muted
        loop
        playsinline
        preload="none"
        disablepictureinpicture
        tabindex="-1"
      ></video>
      <span class="focus-backdrop-nebula focus-backdrop-nebula--a">
        <img
          src={url('assets/focus-nebula.webp')}
          width="405"
          height="720"
          alt=""
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      </span>
      <span class="focus-backdrop-nebula focus-backdrop-nebula--b">
        <img
          src={url('assets/focus-nebula.webp')}
          width="405"
          height="720"
          alt=""
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      </span>
    </div>
    <div
      class="topology-drag-surface"
      data-topology-drag
      aria-hidden="true"
    ></div>
    <h2 id="focus-title" class="focus-title">
      {lang === 'zh' && (
        <small class="focus-title-kicker" lang="en" aria-hidden="true">
          Focus Area
        </small>
      )}
      {lang === 'zh' ? (
        homeContent.focus.title.zh.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))
      ) : (
        <>
          {focusLead} <br class="focus-desktop-br" />
          {focusRest}
        </>
      )}
      <span>{homeContent.focus.auxiliaryTitle[lang]}</span>
    </h2>
    <div class="focus-panels">
      {sectors.map((s) => (
        <article
          id={`sector-${s.id}`}
          class:list={[
            'focus-panel',
            { 'is-active': s.id === initialFocusSector },
          ]}
          data-sector-panel={s.id}
          aria-labelledby={`sector-label-${s.id}`}
        >
          <h3 id={`sector-label-${s.id}`}>
            {lang === 'zh' && (
              <span>
                <b class="focus-slash" aria-hidden="true">
                  /{' '}
                </b>
                {s.zh}
              </span>
            )}
            <span lang="en">{s.en}</span>
          </h3>
          <p>{s.desc[lang]}</p>
        </article>
      ))}
    </div>
    <FocusConstellation lang={lang} />
    <H5FocusConstellation lang={lang} />
    <nav class="focus-links">
      <a href={contactUrl()}>{homeContent.focus.contactLink[lang]} ↗</a>
      <a href="#about">{homeContent.focus.aboutLink[lang]} ↗</a>
    </nav>
  </section>
</div>
<script>
  import { initFocusBackdrop, initFocusStars } from '../scripts/focus-stars';
  initFocusBackdrop();
  initFocusStars();
</script>
<script>
  // Static imports on purpose: the bundler then hands the browser this entry,
  // gsap and both motion modules as one parallel batch. Dynamic imports added
  // two more round trips before any rail or scroll motion could appear, which
  // on a 3G link cost several seconds.
  import { DESKTOP_MOTION, MOBILE_MOTION } from '../scripts/motion-policy';
  import { initHome, initHomeParticles } from '../scripts/home';
  import {
    initH5HomeLayout,
    initMobileHome,
  } from '../scripts/home-mobile-motion';
  initH5HomeLayout();
  initHomeParticles();
  const desktop = matchMedia(DESKTOP_MOTION);
  let started = false;
  const start = () => {
    if (!desktop.matches || started) return;
    started = true;
    initHome();
  };
  start();
  desktop.addEventListener('change', start);
  const mobile = matchMedia(MOBILE_MOTION);
  let mobileStarted = false;
  const startMobile = () => {
    if (!mobile.matches || mobileStarted) return;
    mobileStarted = true;
    initMobileHome();
  };
  startMobile();
  mobile.addEventListener('change', startMobile);
</script>

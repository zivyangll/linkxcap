---
import {
  asset,
  pageUrl,
  homeContent,
  sectors,
  ui,
  type Lang,
} from '../lib/site';
import FocusConstellation from './FocusConstellation.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<noscript>
  <style>
    .focus {
      height: auto;
      min-height: 1100px;
      padding-bottom: 70px;
    }
    .focus-panels {
      position: relative;
      left: auto;
      top: auto;
      width: 85%;
      margin: 650px auto 0;
    }
    .focus-panel {
      display: block !important;
      margin-bottom: 40px;
    }
    .motion-toggle {
      display: none;
    }
    @media (max-width: 767px) {
      .focus-panels {
        margin: 440px 0 0;
        width: 100%;
        inset: auto;
      }
    }
  </style>
</noscript>
<div class="home-story" data-home>
  <section
    class="story-scene opening"
    data-node-id="2002:3297"
    aria-labelledby="opening-title"
  >
    <canvas
      class="scroll-trail"
      data-scroll-trail="opening"
      aria-hidden="true"
    ></canvas>
    <div class="opening-track" aria-hidden="true">
      <i class="diamond"></i>
      <img src={asset('3297', 'imgVector30')} width="2" height="590" alt="" />
    </div>
    <span class="chapter">{homeContent.opening.chapter}</span>
    <h1 id="opening-title" class="opening-title" data-reveal>
      {homeContent.opening.title[lang].map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))}
    </h1>
    <div class="opening-copy" data-reveal>
      <p>
        {homeContent.opening.body[lang].map((line) => (
          <>
            {line}
            <br />
          </>
        ))}
      </p>
    </div>
  </section>
  <div class="philosophy-stage" data-philosophy-stage data-minimal-header>
    <canvas class="philosophy-stage-canvas" aria-hidden="true"></canvas>
    <section
      class="story-scene hero"
      data-node-id="2002:3348"
      data-minimal-header
      aria-labelledby="hero-title"
    >
      <img
        class="hero-orbit ambient-orbit"
        src={asset('3348', 'imgEllipse1')}
        width="2386"
        height="2386"
        alt=""
        loading="lazy"
      />
      <canvas
        class="scroll-trail"
        data-scroll-trail="hero-mobile"
        aria-hidden="true"
      ></canvas>
      <div class="hero-track" aria-hidden="true">
        <i class="diamond hero-track-start"></i>
        <i class="diamond hero-track-end"></i>
        <img
          class="hero-track-line"
          src={asset('3348', 'imgVector30')}
          width="2"
          height="1080"
          alt=""
        />
      </div>
      <h2 id="hero-title" class="hero-title" data-reveal>
        {homeContent.hero.title.map((line, index) => (
          <>
            {index > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      {lang === 'zh' && (
        <p class="hero-zh" data-reveal>
          {homeContent.hero.zhTitle.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      )}
      <a class="orbit-label" href="#about">
        <i class="diamond" aria-hidden="true"></i>
        <em>{homeContent.hero.orbitEyebrow}</em>
        <span>{homeContent.hero.orbitLabel[lang]}</span>
      </a>
    </section>
    <section
      class="story-scene about"
      id="about"
      data-node-id="2002:3438"
      data-minimal-header
      aria-labelledby="about-title"
    >
      <div class="about-decor" aria-hidden="true">
        {[
          ['3474', 0, 1842, 179],
          ['3481', 627, 23, 469],
          ['3482', 628.365, 677, 469],
          ['3483', 0, 648, 469],
        ].map(([id, x, w, h]) => (
          <img
            src={asset('audit', String(id))}
            style={`left:calc(${x}*var(--u));width:calc(${w}*var(--u));height:calc(${h}*var(--u));`}
            width={Number(w)}
            height={Number(h)}
            alt=""
            loading="lazy"
          />
        ))}
      </div>
      <img
        class="about-orbit"
        src={asset('3438', 'imgEllipse1')}
        alt=""
        width="2406"
        height="2406"
        loading="lazy"
      />
      <i class="about-tangent-line" aria-hidden="true"></i>
      <div class="about-rays" aria-hidden="true">
        <i class="about-drop-line"></i>
        <i class="about-ring"></i>
        <span></span>
        <span></span>
        <span></span>
        <i class="diamond"></i>
      </div>
      <div class="about-label">
        {homeContent.about.eyebrow}
        <br />
        {homeContent.about.label[lang]}
      </div>
      <h2 id="about-title" class="about-title" data-reveal>
        {homeContent.about.title[lang].map((line) => (
          <span>{line}</span>
        ))}
      </h2>
      <p class="about-copy" data-reveal>
        {homeContent.about.description[lang].map((line) => (
          <span class="intro-line">{line}</span>
        ))}
      </p>
    </section>
  </div>
  <section
    class="story-scene research"
    data-node-id="2002:3487"
    data-minimal-header
    aria-labelledby="research-title"
  >
    <div class="research-axis" aria-hidden="true">
      <img
        class="research-axis-line"
        src={asset('audit', '3541')}
        width="1616"
        height="41"
        alt=""
      />
      <i class="diamond"></i>
      <img
        class="research-marker"
        src={asset('audit', '3542')}
        width="95"
        height="96"
        alt=""
      />
    </div>
    <h2 id="research-title" data-reveal>
      {homeContent.research.title[0]}
      <br />
      <span>{homeContent.research.title[1]}</span>
    </h2>
    <p class="research-intro" data-reveal>
      {homeContent.about.description[lang].map((line) => (
        <span class="intro-line">{line}</span>
      ))}
    </p>
    <div class="research-stats" data-reveal>
      {homeContent.research.stats.map(({ value, label }) => (
        <div>
          <strong>{value}</strong>
          <span>{label}</span>
        </div>
      ))}
      <p class="data-note">{homeContent.research.dataNote[lang]}</p>
    </div>
  </section>
  <section
    class="story-scene focus"
    id="focus"
    data-node-id="2002:3549"
    data-minimal-header
    data-dark-header
    data-topology
    data-topology-kind="home"
    aria-labelledby="focus-title"
  >
    <canvas class="topology-canvas" aria-hidden="true"></canvas>
    <div
      class="topology-drag-surface"
      data-topology-drag
      aria-hidden="true"
    ></div>
    <h2 id="focus-title" class="focus-title">
      {homeContent.focus.title[0]}
      <br />
      {homeContent.focus.title[1]}
      {lang === 'zh' && <span>{homeContent.focus.zhTitle}</span>}
    </h2>
    <div class="focus-panels">
      {sectors.map((s, i) => (
        <article
          id={`sector-${s.id}`}
          class:list={['focus-panel', { 'is-active': i === 0 }]}
          data-sector-panel={s.id}
          aria-labelledby={`sector-label-${s.id}`}
        >
          <h3 id={`sector-label-${s.id}`}>
            {lang === 'zh' && <span>/ {s.zh}</span>}
            <span lang="en">{s.en}</span>
          </h3>
          <p>{s.desc[lang]}</p>
        </article>
      ))}
    </div>
    <FocusConstellation lang={lang} />
    <nav class="focus-links">
      <a href={pageUrl(lang, 'contact')}>
        {homeContent.focus.contactLink[lang]} ↗
      </a>
      <a href="#about">{homeContent.focus.aboutLink[lang]} ↗</a>
    </nav>
    <button
      class="motion-toggle"
      data-motion-toggle
      data-pause={ui[lang].pause}
      data-resume={ui[lang].resume}
      aria-pressed="false"
    >
      {ui[lang].pause}
    </button>
  </section>
</div>
<script>
  const home = document.querySelector<HTMLElement>('[data-home]');
  const compact = matchMedia('(max-width: 767px)');
  if (compact.matches) {
    home?.setAttribute('data-mobile-static', 'true');
    document
      .querySelector<HTMLElement>('[data-motion-toggle]')
      ?.setAttribute('hidden', '');
  } else {
    const start = () =>
      import('../scripts/home')
        .then((module) => module.initHome())
        .catch(() => {
          document.querySelector<HTMLElement>('[data-motion-toggle]')?.remove();
        });
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>

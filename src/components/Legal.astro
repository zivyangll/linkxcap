---
import { type Lang, legalContent, siteContent, url } from '../lib/site';
const { lang } = Astro.props as { lang: Lang };
const mail = siteContent.email;
// Rendered in one expression so no whitespace appears before the full stop.
const stop = lang === 'zh' ? '。' : '.';
---

<article class="legal-page prose">
  <p class="eyebrow">{legalContent.eyebrow[lang]}</p>
  <h1>{legalContent.title[lang]}</h1>
  {legalContent.sections.map((section, index) => (
    <>
      <h2>{section.heading[lang]}</h2>
      <p>
        {section.body[lang]}
        {index === legalContent.sections.length - 1 && (
          <> {[<a href={`mailto:${mail}`}>{mail}</a>, stop]}</>
        )}
      </p>
    </>
  ))}
  {legalContent.existingSiteUrl && (
    <a
      class="text-link"
      href={legalContent.existingSiteUrl.replace('{lang}', lang)}
      target="_blank"
      rel="noopener noreferrer"
    >
      {legalContent.existingSiteLink[lang]} ↗
    </a>
  )}
  <h2 id="fonts">{legalContent.fontsHeading[lang]}</h2>
  <p>{legalContent.fontsBody[lang]}</p>
  <p>
    {legalContent.fontLicenses.map((license) => (
      <>
        <a href={url(license.path)}>{license.label}</a>
        <br />
      </>
    ))}
  </p>
  <h3>{legalContent.restoreHeading[lang]}</h3>
  <p>{legalContent.restoreBody[lang]}</p>
  <p>
    <a
      href={legalContent.fontDownloadUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      {legalContent.fontDownloadName} · {legalContent.fontDownload[lang]} ↗
    </a>
    <br />
    <a href={url(legalContent.fontNoticePath)}>
      {legalContent.fontNotice[lang]}
    </a>
  </p>
</article>
